#!/usr/bin/env bash
# agent-notion - Notion team operating layer for agents.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

show_help() {
    cat <<'EOF'
agent-notion - Notion team operating layer

CONNECT & SNAPSHOT
  doctor [--json]                         Credential, API, cache, and capability readiness
  snapshot [--json]                       Workspace/cache summary for agents
  auth status [--json]                    Token identity and source
  workspace [--json]                      Bot, users, data sources, and schema mapping

READ
  users [--json]                          List accessible workspace users
  search <query> [--json]                 Search pages/data sources/databases
  read <page-or-url> [--json]             Read page metadata, blocks, and comments
  blocks <page-or-url> [--json]           Recursive block tree
  data-sources list [--json]              List accessible data sources
  data-sources schema <id|name|url>       Inspect a data source schema
  data-sources query <id|name|url>        Query a data source

WRITE & VERIFY
  save --title T --content T              Create a team page or data-source row
  save-group --title T --child n:body     Create a linked hub plus child pages
  task add --title T [--owner ID]         Create a task record using schema mapping
  decision record --title T --content T   Create a decision record
  handoff create --title T --content T    Create an agent handoff record
  comment add <page> --text T             Add a page/block comment
  verify <page-or-url> [--json]           Read back page existence and metadata

CACHE & FRESHNESS
  sync [--limit N] [--json]               Poll Notion and refresh local cache
  cache search <query> [--json]           FTS search over the local cache
  cache status [--json]                   Cache counts and last sync
  webhooks doctor [--json]                Webhook receiver/store readiness
  webhooks ingest --body-file PATH        Validate/store webhook event payload

TEAM SCHEMA
  bootstrap-team [--json]                 Inspect/adopt existing team data sources
  schema show [--json]                    Show adopted role -> data source mapping

SEMANTIC
  embed status [--json]                   Semantic cache status
  embed refresh [--limit N] [--json]      Embed cached pages/blocks when keys exist

COMMON OPTIONS
  --json                                  Structured JSON output
  --limit N                               Result limit
  --data-source ID|name|url               Target data source
  --parent-page ID|url                    Target parent page
  --type task|decision|handoff|note        Team content type
  --scope local|team|project-public|public Metadata scope for saved content

ENVIRONMENT
  NOTION_TOKEN                            Required Notion internal integration token
  NOTION_DATA_SOURCE_ID                   Default data source for saves
  NOTION_PARENT_PAGE_ID                   Default parent page for page saves
  NOTION_WEBHOOK_VERIFICATION_TOKEN       Optional webhook HMAC token
  AGENT_NOTION_WORKSPACE_ID               Local cache namespace override
  AGENT_NOTION_MOCK_FILE                  Test-only mock response map

API KEYS
  agent-do creds required notion          Show setup and feature-specific keys
  agent-do creds store NOTION_TOKEN --stdin

NOTES
  Uses Notion-Version 2025-09-03 and the databases/data-sources model.
  Polling sync is the baseline. Webhooks are an incremental freshness upgrade
  and still require Notion-side subscription setup to a public HTTPS endpoint.
EOF
}

case "${1:-help}" in
    help|--help|-h)
        show_help
        ;;
    *)
        exec python3 "$SCRIPT_DIR/notion_lib/engine.py" "$@"
        ;;
esac
