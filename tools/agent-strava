    if path.suffix.lower() != ".xlsx":
        raise SystemExit("Gear export output must end in .xlsx.")
    require_new_output(path, args.overwrite)
    cache = read_json(CACHE, "activity cache; run: agent-do strava sync")
    profile = json.loads(PROFILE.read_text()) if PROFILE.exists() else {}
    count, activities = export_gear_xlsx(path, cache, profile.get("units") or "imperial")
    print(json.dumps({"exported": str(path), "format": "xlsx", "gear": count, "activities": activities, "units": profile.get("units") or "imperial"}))

def detail_for_activity(activity_id):
    cached = read_json(CACHE, "activity cache; run Sync now after connecting")["activities"]
    if not any(str(activity.get("id")) == str(activity_id) for activity in cached):
        raise SystemExit("Activity is not present in the local cache")
    profile = read_json(PROFILE, "profile")
    token = refresh(profile)
    detail = request(f"{API}/activities/{activity_id}?include_all_efforts=true", token=token)
    stream_query = urllib.parse.urlencode({"keys": "time,distance,altitude,heartrate,latlng,velocity_smooth,grade_smooth,cadence,watts,temp,moving", "key_by_type": "true"})
    streams = request(f"{API}/activities/{activity_id}/streams?{stream_query}", token=token)
    try:
        zones = request(f"{API}/activities/{activity_id}/zones", token=token)
    except SystemExit:
        zones = []
    return {"detail": detail, "streams": streams, "zones": zones}

