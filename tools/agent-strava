#!/usr/bin/env python3
"""Personal, local-only Strava dashboard for agent-do.

Secrets are resolved by the dispatcher or agent-do creds.  This program never
writes a token to the profile or activity cache.
"""
from __future__ import annotations

import argparse, csv, hashlib, json, math, os, secrets, subprocess, sys, tempfile, urllib.parse, urllib.request, webbrowser
from datetime import datetime, timedelta, timezone
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
HOME = Path(os.environ.get("AGENT_DO_HOME", Path.home() / ".agent-do")) / "strava"
PROFILE, CACHE, DASHBOARD = HOME / "profile.json", HOME / "activities.json", HOME / "dashboard.html"
INSIGHTS = HOME / "insights"
AUTH_URL, TOKEN_URL, API = "https://www.strava.com/oauth/authorize", "https://www.strava.com/oauth/token", "https://www.strava.com/api/v3"
INSIGHT_SCHEMA_VERSION = 1

def write_json(path, value):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")
    tmp.chmod(0o600); tmp.replace(path)

def read_json(path, label):
    if not path.exists(): raise SystemExit(f"No Strava {label} found. Run: agent-do strava init")
    return json.loads(path.read_text())

def secret(name):
    if os.environ.get(name): return os.environ[name]
    result = subprocess.run([str(ROOT / "agent-do"), "creds", "get", name, "--reveal"], capture_output=True, text=True)
    if result.returncode == 0 and result.stdout.strip(): return result.stdout.strip()
    raise SystemExit(f"Missing {name}. Run: agent-do strava init")

def store_secret(name, value):
    result = subprocess.run([str(ROOT / "agent-do"), "creds", "store", name, "--stdin"], input=value, capture_output=True, text=True)
    if result.returncode: raise SystemExit(result.stderr.strip() or f"Could not store {name}")

def request(url, data=None, token=None):
    body = urllib.parse.urlencode(data).encode() if data else None
    req = urllib.request.Request(url, data=body, headers={"Accept": "application/json", **({"Authorization": f"Bearer {token}"} if token else {})})
    try:
        with urllib.request.urlopen(req, timeout=30) as response: return json.load(response)
    except Exception as exc: raise SystemExit(f"Strava request failed: {exc}") from exc

def refresh(profile):
    reply = request(TOKEN_URL, {"client_id": profile["client_id"], "client_secret": secret("STRAVA_CLIENT_SECRET"), "grant_type": "refresh_token", "refresh_token": secret("STRAVA_REFRESH_TOKEN")})
    store_secret("STRAVA_REFRESH_TOKEN", reply["refresh_token"])
    return reply["access_token"]

def init(args):
    print("agent-strava keeps your profile, cache, and secrets on this device only.")
    print("Create your own Strava API application at https://www.strava.com/settings/api.")
    print(f"Set its Authorization Callback Domain to {urllib.parse.urlparse(args.redirect_uri).hostname}, then provide its client ID and secret below.")
    client_id = args.client_id or input("Strava client ID: ").strip()
    if not client_id: raise SystemExit("A Strava client ID is required.")
    client_secret = None
    if not client_secret and sys.stdin.isatty():
        import getpass; client_secret = getpass.getpass("Strava client secret (stored in OS secure storage): ")
    if not client_secret: raise SystemExit("Provide --client-secret-stdin or run interactively.")
    store_secret("STRAVA_CLIENT_SECRET", client_secret)
    write_json(PROFILE, {"client_id": client_id, "redirect_uri": args.redirect_uri, "units": "imperial", "created_at": datetime.now(timezone.utc).isoformat()})
    print("Profile initialized locally. Next run: agent-do strava connect")

def connect(args):
    profile = read_json(PROFILE, "profile")
    state, received = secrets.token_urlsafe(24), {}
    class Callback(BaseHTTPRequestHandler):
        def do_GET(self):
            received.update({k: v[0] for k, v in urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query).items()})
            self.send_response(200); self.end_headers(); self.wfile.write(b"Strava connected. You may return to agent-do.")
        def log_message(self, *unused): pass
    parsed = urllib.parse.urlparse(profile["redirect_uri"])
    if parsed.hostname not in ("127.0.0.1", "localhost") or not parsed.port: raise SystemExit("This initial local-only version requires a localhost redirect URI with a port.")
    server = HTTPServer((parsed.hostname, parsed.port), Callback)
    query = urllib.parse.urlencode({"client_id": profile["client_id"], "redirect_uri": profile["redirect_uri"], "response_type": "code", "approval_prompt": "force", "scope": "activity:read,activity:read_all", "state": state})
    url = f"{AUTH_URL}?{query}"
    print("Opening Strava authorization in your browser…")
    webbrowser.open(url)
    server.timeout = args.timeout
    server.handle_request()
    if received.get("state") != state or not received.get("code"): raise SystemExit("Authorization was not completed or state validation failed.")
    reply = request(TOKEN_URL, {"client_id": profile["client_id"], "client_secret": secret("STRAVA_CLIENT_SECRET"), "code": received["code"], "grant_type": "authorization_code"})
    store_secret("STRAVA_REFRESH_TOKEN", reply["refresh_token"])
    athlete = reply.get("athlete", {})
    profile.update({"athlete_id": athlete.get("id"), "athlete_name": " ".join(filter(None, [athlete.get("firstname"), athlete.get("lastname")])), "scopes": "activity:read,activity:read_all", "connected_at": datetime.now(timezone.utc).isoformat()})
    write_json(PROFILE, profile)
    print(f"Connected locally as {profile.get('athlete_name') or profile['athlete_id']}. Run: agent-do strava sync")

def sync(args):
    profile, token = read_json(PROFILE, "profile"), refresh(read_json(PROFILE, "profile"))
    after = int((datetime.now(timezone.utc) - timedelta(days=args.days)).timestamp())
    activities, page = [], 1
    while True:
        batch = request(f"{API}/athlete/activities?{urllib.parse.urlencode({'after': after, 'per_page': 100, 'page': page})}", token=token)
        activities.extend(batch)
        if len(batch) < 100: break
        page += 1
    gear = {}
    for activity in activities:
        summary = activity.get("gear")
        item_id = gear_id(activity)
        if not item_id or item_id in gear: continue
        try:
            detail = request(f"{API}/gear/{urllib.parse.quote(item_id, safe='')}", token=token)
        except SystemExit:
            # Summary activities normally include enough equipment data to keep
            # the local dashboard useful if one equipment lookup is unavailable.
            detail = summary if isinstance(summary, dict) else {"id": item_id}
        gear[item_id] = {**(summary if isinstance(summary, dict) else {}), **detail}
    write_json(CACHE, {"synced_at": datetime.now(timezone.utc).isoformat(), "activities": activities, "gear": list(gear.values())})
    profile["last_sync_at"] = datetime.now(timezone.utc).isoformat(); write_json(PROFILE, profile)
    print(f"Synced {len(activities)} activities from the last {args.days} days.")

def started(activity):
    return datetime.fromisoformat(activity["start_date"].replace("Z", "+00:00"))

def activity_kind(activity):
    return activity.get("sport_type") or activity.get("type") or "Other"

def gear_id(activity):
    """Return the associated Strava equipment id, if this activity has one."""
    if activity.get("gear_id"): return str(activity["gear_id"])
    gear = activity.get("gear")
    if isinstance(gear, dict) and gear.get("id") is not None: return str(gear["id"])
    if isinstance(gear, str) and gear: return gear
    return None

def gear_summary(cache):
    """Combine synced equipment with the local activity cache for the gear view."""
    activities_by_gear = {}
    for activity in cache.get("activities", []):
        item_id = gear_id(activity)
        if item_id: activities_by_gear.setdefault(item_id, []).append(activity)
    items = {str(item.get("id")): item for item in cache.get("gear", []) if isinstance(item, dict) and item.get("id") is not None}
    # Older caches did not retain a top-level gear collection. Their activity
    # summaries still provide a useful fallback until the next explicit sync.
    for activity in cache.get("activities", []):
        item_id = gear_id(activity)
        if item_id and item_id not in items and isinstance(activity.get("gear"), dict): items[item_id] = activity["gear"]
    result = []
    for item_id, item in items.items():
        activities = activities_by_gear.get(item_id, [])
        cached_distance = sum(activity.get("distance", 0) for activity in activities)
        result.append({
            "id": item_id,
            "name": item.get("name") or " ".join(filter(None, [item.get("brand_name"), item.get("model_name")])) or "Unnamed gear",
            "brand_name": item.get("brand_name"),
            "model_name": item.get("model_name"),
            "primary": bool(item.get("primary")),
            "distance_m": item.get("distance") if item.get("distance") is not None else cached_distance,
            "activity_count": len(activities),
            "last_used_at": max((activity.get("start_date") for activity in activities), default=None),
        })
    return sorted(result, key=lambda item: (item["distance_m"] or 0), reverse=True)

def activities_for_gear(cache, item_id):
    return sorted((activity for activity in cache.get("activities", []) if gear_id(activity) == item_id), key=started, reverse=True)

def is_running(activity):
    """Whether an activity's moving time and distance describe a pace."""
    kind = activity_kind(activity).lower()
    return "run" in kind or "walk" in kind

def is_biking(activity):
    kind = activity_kind(activity).lower()
    return "ride" in kind or "bike" in kind

def summarize(activities, days=7, activity_type=None):
    cutoff = datetime.now(timezone.utc) - timedelta(days=days)
    selected = [a for a in activities if started(a) >= cutoff and (not activity_type or activity_kind(a) == activity_type)]
    weeks = {}
    pace_metric = "pace" if not activity_type or is_running({"sport_type": activity_type}) else "speed" if is_biking({"sport_type": activity_type}) else None
    pace_distance_km = 0
    pace_seconds = 0
    for activity in selected:
        stamp = started(activity)
        monday = (stamp - timedelta(days=stamp.weekday())).date().isoformat()
        bucket = weeks.setdefault(monday, {"week": monday, "distance_km": 0, "moving_minutes": 0, "pace_distance_km": 0, "pace_seconds": 0})
        bucket["distance_km"] += activity.get("distance", 0) / 1000
        bucket["moving_minutes"] += activity.get("moving_time", 0) / 60
        include_pace = (not activity_type and is_running(activity)) or (activity_type and (is_running(activity) or is_biking(activity)))
        if include_pace:
            bucket["pace_distance_km"] += activity.get("distance", 0) / 1000
            bucket["pace_seconds"] += activity.get("moving_time", 0)
            pace_distance_km += activity.get("distance", 0) / 1000
            pace_seconds += activity.get("moving_time", 0)
    return {
        "days": days,
        "distance_km": round(sum(a.get("distance", 0) for a in selected) / 1000, 1),
        "elevation_m": round(sum(a.get("total_elevation_gain", 0) for a in selected)),
        "moving_minutes": round(sum(a.get("moving_time", 0) for a in selected) / 60),
        "activity_count": len(selected),
        "activities": sorted(selected, key=started, reverse=True),
        "weekly": [{
            "week": bucket["week"],
            "distance_km": round(bucket["distance_km"], 1),
            "moving_minutes": round(bucket["moving_minutes"]),
            "pace_seconds_per_km": round(bucket["pace_seconds"] / bucket["pace_distance_km"]) if bucket["pace_distance_km"] else None,
            "average_speed_mps": round(bucket["pace_distance_km"] * 1000 / bucket["pace_seconds"], 2) if bucket["pace_seconds"] else None,
        } for _, bucket in sorted(weeks.items())],
        "pace_metric": pace_metric,
        "pace_seconds_per_km": round(pace_seconds / pace_distance_km) if pace_distance_km else None,
        "average_speed_mps": round(pace_distance_km * 1000 / pace_seconds, 2) if pace_seconds else None,
    }

def insight_metric_summary(activities):
    """Return only aggregate, provider-safe metrics for a set of activities."""
    distance_m = sum(activity.get("distance", 0) or 0 for activity in activities)
    moving_seconds = sum(activity.get("moving_time", 0) or 0 for activity in activities)
    elevation_m = sum(activity.get("total_elevation_gain", 0) or 0 for activity in activities)
    pace_activities = [activity for activity in activities if is_running(activity) and activity.get("distance", 0) and activity.get("moving_time", 0)]
    pace_distance_m = sum(activity["distance"] for activity in pace_activities)
    pace_seconds = sum(activity["moving_time"] for activity in pace_activities)
    bike_activities = [activity for activity in activities if is_biking(activity) and activity.get("distance", 0) and activity.get("moving_time", 0)]
    bike_distance_m = sum(activity["distance"] for activity in bike_activities)
    bike_seconds = sum(activity["moving_time"] for activity in bike_activities)
    heart_rates = [activity["average_heartrate"] for activity in activities if activity.get("average_heartrate") is not None]
    return {
        "activity_count": len(activities),
        "distance_km": round(distance_m / 1000, 2),
        "moving_minutes": round(moving_seconds / 60),
        "elevation_m": round(elevation_m),
        "running_pace_seconds_per_km": round(pace_seconds / (pace_distance_m / 1000)) if pace_distance_m else None,
        "cycling_average_speed_mps": round(bike_distance_m / bike_seconds, 2) if bike_seconds else None,
        "average_heartrate_bpm": round(sum(heart_rates) / len(heart_rates)) if heart_rates else None,
    }

def build_insight_summary(activities, days, activity_filter=None, now=None):
    """Build a deterministic, redacted local analysis contract for future insights.

    This intentionally returns aggregates only. Names, notes, IDs, timestamps,
    map polylines, location, streams, and OAuth material must never enter the
    provider-facing summary.
    """
    if days < 1: raise ValueError("days must be at least 1")
    now = now or datetime.now(timezone.utc)
    cutoff = now - timedelta(days=days)
    selected = [activity for activity in activities if started(activity) >= cutoff and (not activity_filter or activity_kind(activity) == activity_filter)]
    midpoint = cutoff + timedelta(days=days / 2)
    baseline = [activity for activity in selected if started(activity) < midpoint]
    recent = [activity for activity in selected if started(activity) >= midpoint]
    sport_counts, weeks = {}, {}
    for activity in selected:
        kind = activity_kind(activity)
        sport_counts[kind] = sport_counts.get(kind, 0) + 1
        stamp = started(activity)
        monday = (stamp - timedelta(days=stamp.weekday())).date().isoformat()
        weeks.setdefault(monday, []).append(activity)
    comparable_pace = [activity for activity in selected if is_running(activity) and activity.get("distance", 0) and activity.get("moving_time", 0)]
    result = {
        "schema_version": INSIGHT_SCHEMA_VERSION,
        "range": {"days": days, "start": cutoff.date().isoformat(), "end": now.date().isoformat(), "activity_filter": activity_filter},
        "summary": insight_metric_summary(selected),
        "sports": [{"sport_type": kind, "activity_count": count} for kind, count in sorted(sport_counts.items())],
        "weekly": [{"week": week, **insight_metric_summary(bucket)} for week, bucket in sorted(weeks.items())],
        "comparison": {
            "baseline": insight_metric_summary(baseline),
            "recent": insight_metric_summary(recent),
            "comparable_pace_activity_count": len(comparable_pace),
            "sufficient_for_period_comparison": len(baseline) >= 2 and len(recent) >= 2,
        },
        "data_quality": {
            "sufficient_for_observation": len(selected) >= 3,
            "has_heart_rate_data": any(activity.get("average_heartrate") is not None for activity in selected),
            "route_comparison_available": False,
            "notes": ["No activities match this selected range and filter."] if not selected else [],
        },
    }
    groups = repeat_route_groups(selected)
    result["repeat_routes"] = groups
    result["data_quality"]["route_comparison_available"] = bool(groups)
    if not groups and selected:
        result["data_quality"]["notes"].append("No comparable repeat routes were found in this selection.")
    return result

def decode_polyline(encoded):
    """Decode a Google encoded polyline without retaining or emitting coordinates."""
    points, index, latitude, longitude = [], 0, 0, 0
    while index < len(encoded):
        values = []
        for _ in range(2):
            shift, value = 0, 0
            while True:
                byte = ord(encoded[index]) - 63; index += 1
                value |= (byte & 0x1f) << shift; shift += 5
                if byte < 0x20: break
            values.append(~(value >> 1) if value & 1 else value >> 1)
        latitude += values[0]; longitude += values[1]
        points.append((latitude / 1e5, longitude / 1e5))
    return points

def route_signature(activity):
    """Return a coarse local-only route signature, or None for unavailable paths."""
    encoded = (activity.get("map") or {}).get("summary_polyline")
    if not encoded: return None
    try: points = decode_polyline(encoded)
    except (IndexError, TypeError): return None
    if len(points) < 2: return None
    # 0.001 degrees (~111m) tolerates normal GPS jitter without exposing a route.
    cells = frozenset((round(latitude, 3), round(longitude, 3)) for latitude, longitude in points)
    return {"cells": cells, "start": points[0], "end": points[-1]}

def route_distance(a, b):
    latitude = math.radians(b[0] - a[0]); longitude = math.radians(b[1] - a[1])
    base = math.sin(latitude / 2) ** 2 + math.cos(math.radians(a[0])) * math.cos(math.radians(b[0])) * math.sin(longitude / 2) ** 2
    return 6371000 * 2 * math.atan2(math.sqrt(base), math.sqrt(1 - base))

def routes_match(first, second):
    if activity_kind(first).lower() != activity_kind(second).lower(): return False
    first_distance, second_distance = first.get("distance", 0) or 0, second.get("distance", 0) or 0
    if not first_distance or not second_distance or min(first_distance, second_distance) / max(first_distance, second_distance) < 0.8: return False
    one, two = route_signature(first), route_signature(second)
    if not one or not two: return False
    union = one["cells"] | two["cells"]
    overlap = len(one["cells"] & two["cells"]) / len(union) if union else 0
    same_direction = route_distance(one["start"], two["start"]) + route_distance(one["end"], two["end"]) <= route_distance(one["start"], two["end"]) + route_distance(one["end"], two["start"])
    return overlap >= 0.6 and same_direction

def repeat_route_groups(activities):
    """Find comparable local routes and return redacted aggregate observations only."""
    candidates = [activity for activity in activities if route_signature(activity)]
    groups = []
    for activity in candidates:
        for group in groups:
            if any(routes_match(activity, member) for member in group):
                group.append(activity); break
        else: groups.append([activity])
    result = []
    for group in groups:
        if len(group) < 2: continue
        metrics = insight_metric_summary(group)
        seed = min(group, key=started)
        fingerprint = ";".join(f"{latitude:.3f},{longitude:.3f}" for latitude, longitude in sorted(route_signature(seed)["cells"]))
        token = hashlib.sha256(f"{activity_kind(seed)}|{fingerprint}".encode()).hexdigest()[:10]
        result.append({"route_group": f"route-{token}", "sport_type": activity_kind(group[0]), "activity_count": len(group), "distance_km": metrics["distance_km"], "running_pace_seconds_per_km": metrics["running_pace_seconds_per_km"], "cycling_average_speed_mps": metrics["cycling_average_speed_mps"]})
    return sorted(result, key=lambda item: (-item["activity_count"], item["route_group"]))

def insight_prompt(summary):
    return """You are a cautious training-reflection assistant. Use only the supplied aggregate data. Give concise, evidence-qualified observations about consistency, recent load, pace/speed, and repeat-route performance. Do not diagnose, prescribe treatment, claim fitness changes without comparable evidence, or invent missing context. Explicitly say when data is insufficient. End with one or two questions the athlete could consider.\n\nTraining summary:\n""" + json.dumps(summary, sort_keys=True)

def provider_key(provider):
    name = "OPENAI_API_KEY" if provider == "openai" else "ANTHROPIC_API_KEY" if provider == "anthropic" else None
    if not name: raise SystemExit("Provider must be openai or anthropic.")
    try: return secret(name)
    except SystemExit as exc: raise SystemExit(f"Missing {name}. Store it with: agent-do creds store {name} --stdin") from exc

def provider_request(provider, model, prompt):
    key = provider_key(provider)
    if provider == "openai":
        url, payload, headers = "https://api.openai.com/v1/responses", {"model": model or "gpt-5-mini", "input": prompt}, {"Authorization": f"Bearer {key}"}
    else:
        url, payload, headers = "https://api.anthropic.com/v1/messages", {"model": model or "claude-sonnet-4-5", "max_tokens": 900, "messages": [{"role": "user", "content": prompt}]}, {"x-api-key": key, "anthropic-version": "2023-06-01"}
    request = urllib.request.Request(url, data=json.dumps(payload).encode(), headers={"Content-Type": "application/json", **headers})
    try:
        with urllib.request.urlopen(request, timeout=60) as response: reply = json.load(response)
    except Exception as exc: raise SystemExit(f"{provider.title()} insight request failed: {exc}") from exc
    if provider == "openai":
        text = reply.get("output_text") or "".join(part.get("text", "") for item in reply.get("output", []) for part in item.get("content", []) if part.get("type") == "output_text")
    else:
        text = "".join(part.get("text", "") for part in reply.get("content", []) if part.get("type") == "text")
    if not text.strip(): raise SystemExit(f"{provider.title()} returned no insight text.")
    return text.strip()

def save_insight_receipt(provider, model, summary, output):
    receipt_id = f"{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}-{secrets.token_hex(4)}"
    receipt = {"receipt_id": receipt_id, "schema_version": INSIGHT_SCHEMA_VERSION, "created_at": datetime.now(timezone.utc).isoformat(), "provider": provider, "model": model, "input_summary": summary, "output": output, "disclaimer": "Reflective training observations only; not medical advice or a coaching prescription."}
    write_json(INSIGHTS / f"{receipt_id}.json", receipt)
    return receipt

def insight_receipts():
    if not INSIGHTS.exists(): return []
    return sorted((json.loads(path.read_text()) for path in INSIGHTS.glob("*.json")), key=lambda item: item["created_at"], reverse=True)

def insight(args):
    if args.insights_action == "history":
        print(json.dumps([{key: receipt[key] for key in ("receipt_id", "created_at", "provider", "model")} for receipt in insight_receipts()], indent=2)); return
    if args.insights_action == "show":
        if not args.receipt_id: raise SystemExit("Usage: agent-do strava insights show RECEIPT_ID")
        path = INSIGHTS / f"{args.receipt_id}.json"
        if not path.exists(): raise SystemExit(f"No local insight receipt: {args.receipt_id}")
        print(path.read_text(), end=""); return
    if args.days < 1: raise SystemExit("--days must be at least 1")
    cache = read_json(CACHE, "activity cache; run: agent-do strava sync")
    summary = build_insight_summary(cache["activities"], args.days, args.activity)
    if args.preview or not args.send:
        print(json.dumps(summary, indent=2, sort_keys=True))
        if not args.send: print("\nPreview only. Re-run with --send --provider openai|anthropic to make an external AI request.", file=sys.stderr)
        if not args.send: return
    if not args.provider: raise SystemExit("--send requires --provider openai or --provider anthropic")
    output = provider_request(args.provider, args.model, insight_prompt(summary))
    receipt = save_insight_receipt(args.provider, args.model or ("gpt-5-mini" if args.provider == "openai" else "claude-sonnet-4-5"), summary, output)
    print(json.dumps({"receipt_id": receipt["receipt_id"], "output": output, "disclaimer": receipt["disclaimer"]}, indent=2))

def export_rows(activities, units):
    """Return a shareable, normalized activity table without route or token data."""
    metric = units == "metric"
    distance_factor = 1 if metric else 0.621371
    elevation_factor = 1 if metric else 3.28084
    distance_unit, elevation_unit = ("km", "m") if metric else ("mi", "ft")
    rows = []
    for activity in sorted(activities, key=started, reverse=True):
        distance_km = activity.get("distance", 0) / 1000
        moving_seconds = activity.get("moving_time", 0)
        kind = activity_kind(activity)
        calories = activity.get("calories")
        if calories is None and activity.get("kilojoules") is not None:
            calories = round(activity["kilojoules"] / 4.184)
        row = {
            "Date": started(activity).date().isoformat(),
            "Sport": kind,
            f"Distance ({distance_unit})": round(distance_km * distance_factor, 2),
            "Moving time": moving_seconds,
            "Elapsed time": activity.get("elapsed_time", 0),
            f"Elevation gain ({elevation_unit})": round(activity.get("total_elevation_gain", 0) * elevation_factor),
            "Average heart rate (bpm)": activity.get("average_heartrate"),
            "Max heart rate (bpm)": activity.get("max_heartrate"),
            "Calories": calories,
            "Activity ID": activity.get("id"),
        }
        if is_running(activity):
            row[f"Average pace (min:sec/{distance_unit})"] = round(moving_seconds / (distance_km * distance_factor)) if distance_km else None
        elif is_biking(activity):
            row[f"Average speed ({distance_unit}/h)"] = round(distance_km * distance_factor / (moving_seconds / 3600), 2) if moving_seconds else None
        rows.append(row)
    return rows

def monthly_rollup(activities, units):
    metric = units == "metric"
    distance_factor, distance_unit = (1, "km") if metric else (0.621371, "mi")
    elevation_factor, elevation_unit = (1, "m") if metric else (3.28084, "ft")
    months = {}
    for activity in activities:
        month = started(activity).strftime("%Y-%m")
        bucket = months.setdefault(month, {"Month": month, "Activities": 0, f"Distance ({distance_unit})": 0, "Moving time": 0, f"Elevation gain ({elevation_unit})": 0})
        bucket["Activities"] += 1
        bucket[f"Distance ({distance_unit})"] += activity.get("distance", 0) / 1000 * distance_factor
        bucket["Moving time"] += activity.get("moving_time", 0)
        bucket[f"Elevation gain ({elevation_unit})"] += activity.get("total_elevation_gain", 0) * elevation_factor
    return [{key: round(value, 2) if isinstance(value, float) else value for key, value in value.items()} for _, value in sorted(months.items())]

def activity_filters(args):
    """Normalize repeated, comma-delimited, or bracketed CLI activity filters."""
    raw = getattr(args, "activity", None) or ([] if not getattr(args, "type", None) else [args.type])
    values = raw if isinstance(raw, list) else [raw]
    return [item.strip().lower() for value in values for item in str(value).strip().strip("[]").split(",") if item.strip()]

def matches_activity_filter(activity, filters):
    if not filters: return True
    sport = "".join(character for character in activity_kind(activity).lower() if character.isalnum())
    for item in filters:
        normalized = "".join(character for character in item if character.isalnum())
        if normalized == "run" and "run" in sport: return True
        if normalized in ("bike", "bicycle") and ("ride" in sport or "bike" in sport): return True
        if sport == normalized: return True
    return False

def selected_activities(args):
    cache = read_json(CACHE, "activity cache; run: agent-do strava sync")
    profile = json.loads(PROFILE.read_text()) if PROFILE.exists() else {}
    cutoff = datetime.now(timezone.utc) - timedelta(days=args.days)
    filters = activity_filters(args)
    activities = [a for a in cache["activities"] if started(a) >= cutoff and matches_activity_filter(a, filters)]
    return cache, activities, profile.get("units") or "imperial"

def require_new_output(path, overwrite):
    if path.exists() and not overwrite:
        raise SystemExit(f"Refusing to overwrite {path}. Re-run with --overwrite to replace it.")
    if not path.parent.exists():
        raise SystemExit(f"Output directory does not exist: {path.parent}")

def format_duration(seconds):
    seconds = round(seconds or 0)
    return f"{seconds // 3600}:{seconds % 3600 // 60:02d}:{seconds % 60:02d}"

def format_pace(seconds):
    if seconds is None: return ""
    seconds = round(seconds)
    return f"{seconds // 60:02d}:{seconds % 60:02d}"

def format_export_duration(seconds):
    """Format a duration consistently for a human-readable Excel export."""
    seconds = round(seconds or 0)
    minutes, seconds = divmod(seconds, 60)
    hours, minutes = divmod(minutes, 60)
    return f"{hours:02d}:{minutes:02d}:{seconds:02d}" if hours else f"{minutes:02d}:{seconds:02d}"

def spreadsheet_value(header, value):
    if header in ("Moving time", "Elapsed time"):
        return format_export_duration(value)
    if "pace" in header.lower() and value is not None:
        return format_pace(value)
    return value

def csv_rows(rows):
    formatted = []
    for row in rows:
        formatted.append({key: format_pace(value) if "pace" in key.lower() else format_duration(value) if key in ("Moving time", "Elapsed time") else f"{value:,}" if isinstance(value, (int, float)) else value for key, value in row.items()})
    return formatted

def export_csv(path, rows):
    headers = list(dict.fromkeys(key for row in rows for key in row))
    if not headers:
        headers = ["Date", "Sport", "Distance (mi)", "Moving time"]
    with path.open("w", newline="", encoding="utf-8") as output:
        writer = csv.DictWriter(output, fieldnames=headers, extrasaction="ignore")
        writer.writeheader(); writer.writerows(csv_rows(rows))

def export_xlsx(path, cache, activities, units, rows, days, activity_type):
    try:
        from openpyxl import Workbook
        from openpyxl.styles import Font, PatternFill
        from openpyxl.utils import get_column_letter
    except ImportError as exc:
        raise SystemExit("Excel export requires openpyxl. Run ./install.sh from the agent-do checkout, or install it with: python3 -m pip install 'openpyxl>=3.1.0'") from exc

    workbook = Workbook(); summary = workbook.active; summary.title = "Summary"
    totals = summarize(activities, days=3660)
    distance_factor, elevation_factor = (1, 1) if units == "metric" else (0.621371, 3.28084)
    distance_unit, elevation_unit = ("km", "m") if units == "metric" else ("mi", "ft")
    summary_rows = [
        ("Exported at (UTC)", datetime.now(timezone.utc).isoformat()),
        ("Cache last synced", cache.get("synced_at", "Unknown")),
        ("Date range", f"Last {days} days"),
        ("Activity type", activity_type or "All activities"),
        ("Units", units),
        ("Activities", totals["activity_count"]),
        (f"Distance ({distance_unit})", round(totals["distance_km"] * distance_factor, 1)),
        ("Moving time", totals["moving_minutes"] * 60),
        (f"Elevation gain ({elevation_unit})", round(totals["elevation_m"] * elevation_factor)),
    ]
    summary.append(["Metric", "Value"])
    for row in summary_rows: summary.append(row)

    def add_table(name, table_rows):
        sheet = workbook.create_sheet(name)
        headers = list(dict.fromkeys(key for row in table_rows for key in row))
        if headers: sheet.append(headers)
        for row in table_rows:
            sheet.append([spreadsheet_value(header, row.get(header)) for header in headers])
        return sheet

    activity_sheet = add_table("Activities", rows)
    weekly = summarize(activities, days=3660)["weekly"]
    weekly_rows = [{
        "Week starting": item["week"],
        f"Distance ({distance_unit})": round(item["distance_km"] * distance_factor, 2),
        "Moving time": item["moving_minutes"] * 60,
        f"Average pace (min:sec/{distance_unit})": round(item["pace_seconds_per_km"] / distance_factor) if item["pace_seconds_per_km"] else None,
        f"Average speed ({distance_unit}/h)": round(item["average_speed_mps"] * 3.6 * distance_factor, 2) if item["average_speed_mps"] else None,
    } for item in weekly]
    weekly_sheet = add_table("Weekly", weekly_rows)
    monthly_sheet = add_table("Monthly", monthly_rollup(activities, units))
    dictionary = add_table("Data dictionary", [
        {"Field": "Activity ID", "Definition": "Strava activity identifier; excludes names, routes, notes, photos, and OAuth secrets."},
        {"Field": "Distance / elevation", "Definition": f"Values use the selected {units} display units unless the column states metres or kilometres."},
        {"Field": "Date", "Definition": "Activity start date in UTC."},
        {"Field": "Moving / elapsed time", "Definition": "Displayed as MM:SS below one hour or HH:MM:SS at one hour and above."},
        {"Field": "Calories", "Definition": "Strava calories when available; otherwise an estimated kcal value converted from Strava kilojoules."},
        {"Field": "Export scope", "Definition": "Only activities in the selected local-cache date range and activity type."},
    ])
    summary["B9"] = format_export_duration(summary["B9"].value)
    for sheet in workbook.worksheets:
        sheet.freeze_panes = "A2" if sheet.max_row > 1 else None
        for cell in sheet[1]:
            cell.font = Font(bold=True, color="FFFFFF")
            cell.fill = PatternFill("solid", fgColor="1F4E78")
        for column in range(1, sheet.max_column + 1):
            header = str(sheet.cell(1, column).value or "").lower()
            for row in range(2, sheet.max_row + 1):
                cell = sheet.cell(row, column)
                if isinstance(cell.value, (int, float)):
                    cell.number_format = "#,##0.00" if any(word in header for word in ("distance", "speed")) else "#,##0"
            width = max((len(str(sheet.cell(row, column).value or "")) for row in range(1, sheet.max_row + 1)), default=10)
            sheet.column_dimensions[get_column_letter(column)].width = min(max(width + 2, 12), 48)
    for row in range(2, summary.max_row + 1):
        label, value = str(summary.cell(row, 1).value or "").lower(), summary.cell(row, 2)
        if isinstance(value.value, (int, float)): value.number_format = "#,##0.00" if "distance" in label else "#,##0"
    workbook.save(path)

def gear_sheet_name(name, used):
    """Return a unique Excel-safe worksheet name for a local gear item."""
    stem = "".join(" " if character in "[]:*?/\\" else character for character in name).strip() or "Unnamed gear"
    stem = stem[:31]
    candidate, suffix = stem, 2
    while candidate.lower() in used:
        ending = f" ({suffix})"
        candidate = stem[:31 - len(ending)] + ending
        suffix += 1
    used.add(candidate.lower())
    return candidate

def export_gear_xlsx(path, cache, units):
    """Write a local gear workbook: summary first, then one activity sheet per item."""
    try:
        from openpyxl import Workbook
        from openpyxl.styles import Font, PatternFill
        from openpyxl.utils import get_column_letter
    except ImportError as exc:
        raise SystemExit("Excel export requires openpyxl. Run ./install.sh from the agent-do checkout, or install it with: python3 -m pip install 'openpyxl>=3.1.0'") from exc

    items = gear_summary(cache)
    distance_factor, distance_unit = (1, "km") if units == "metric" else (0.621371, "mi")
    workbook = Workbook(); summary = workbook.active; summary.title = "Gear"
    summary.append(["Gear", f"Total distance ({distance_unit})", "Last used", "Activities"])
    for item in items:
        last_used = started({"start_date": item["last_used_at"]}).date().isoformat() if item["last_used_at"] else None
        summary.append([item["name"], round((item["distance_m"] or 0) / 1000 * distance_factor, 2), last_used, item["activity_count"]])

    used_names = {"gear"}
    for item in items:
        sheet = workbook.create_sheet(gear_sheet_name(item["name"], used_names))
        rows = export_rows(activities_for_gear(cache, item["id"]), units)
        headers = list(dict.fromkeys(key for row in rows for key in row))
        if not headers:
            headers = ["Date", "Sport", f"Distance ({distance_unit})", "Moving time"]
        sheet.append(headers)
        for row in rows:
            sheet.append([spreadsheet_value(header, row.get(header)) for header in headers])

    for sheet in workbook.worksheets:
        sheet.freeze_panes = "A2"
        for cell in sheet[1]:
            cell.font = Font(bold=True, color="FFFFFF")
            cell.fill = PatternFill("solid", fgColor="1F4E78")
        for column in range(1, sheet.max_column + 1):
            header = str(sheet.cell(1, column).value or "").lower()
            for row in range(2, sheet.max_row + 1):
                cell = sheet.cell(row, column)
                if isinstance(cell.value, (int, float)):
                    cell.number_format = "#,##0.00" if "distance" in header else "#,##0"
            width = max((len(str(sheet.cell(row, column).value or "")) for row in range(1, sheet.max_row + 1)), default=10)
            sheet.column_dimensions[get_column_letter(column)].width = min(max(width + 2, 12), 48)
    workbook.save(path)
    return len(items), sum(item["activity_count"] for item in items)

def export_download(fmt, days, activity_type):
    """Build a filtered export for a browser download without retaining a copy."""
    args = argparse.Namespace(days=days, type=activity_type, activity=None)
    cache, activities, units = selected_activities(args)
    rows = export_rows(activities, units)
    with tempfile.TemporaryDirectory() as directory:
        path = Path(directory) / f"strava-export.{fmt}"
        if fmt == "csv": export_csv(path, rows)
        else: export_xlsx(path, cache, activities, units, rows, days, activity_type)
        return path.read_bytes(), len(activities)

def export(args):
    if args.days < 1:
        raise SystemExit("--days must be at least 1")
    path = Path(args.output).expanduser()
    fmt = args.format or path.suffix.lower().removeprefix(".")
    if fmt not in ("csv", "xlsx"):
        raise SystemExit("Output path must end in .csv or .xlsx, or specify --format csv|xlsx.")
    if path.suffix and path.suffix.lower() != f".{fmt}":
        raise SystemExit(f"Output extension {path.suffix} does not match --format {fmt}.")
    if not path.suffix:
        path = path.with_suffix(f".{fmt}")
    require_new_output(path, args.overwrite)
    cache, activities, units = selected_activities(args)
    rows = export_rows(activities, units)
    if fmt == "csv": export_csv(path, rows)
    else: export_xlsx(path, cache, activities, units, rows, args.days, ", ".join(activity_filters(args)) or None)
    print(json.dumps({"exported": str(path), "format": fmt, "activities": len(activities), "days": args.days, "activity": activity_filters(args), "units": units}))

def gear_export_download():
    """Build a gear workbook for browser download without retaining a copy."""
    cache = read_json(CACHE, "activity cache; run: agent-do strava sync")
    profile = json.loads(PROFILE.read_text()) if PROFILE.exists() else {}
    with tempfile.TemporaryDirectory() as directory:
        path = Path(directory) / "strava-gear.xlsx"
        count, activities = export_gear_xlsx(path, cache, profile.get("units") or "imperial")
        return path.read_bytes(), count, activities

def gear_export(args):
