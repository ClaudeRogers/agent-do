#!/usr/bin/env bash
# agent-usb - USB device management

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if [[ -f "$REPO_ROOT/lib/json-output.sh" ]]; then
    # shellcheck source=lib/json-output.sh
    source "$REPO_ROOT/lib/json-output.sh"
else
    OUTPUT_FORMAT="${OUTPUT_FORMAT:-text}"
    parse_output_format() {
        local args=()
        for arg in "$@"; do
            if [[ "$arg" == "--json" ]]; then
                OUTPUT_FORMAT="json"
            else
                args+=("$arg")
            fi
        done
        PARSED_ARGS=("${args[@]}")
    }
    json_error() {
        local message="$1"
        local code="${2:-1}"
        if [[ "${OUTPUT_FORMAT:-text}" == "json" ]]; then
            python3 -c "import json,sys; print(json.dumps({'success': False, 'error': sys.argv[1], 'code': int(sys.argv[2])}, indent=2))" "$message" "$code"
        else
            echo "Error: $message" >&2
        fi
        return "$code"
    }
fi

# Emit a captured block of text, or an explicit empty-result message when blank.
# In --json mode, wrap the lines in a structured document so the result is always
# a single valid JSON document.
emit_lines() {
    local command="$1"
    local empty_message="$2"
    local text="$3"

    if [[ "${OUTPUT_FORMAT:-text}" == "json" ]]; then
        python3 - "$command" "$empty_message" "$text" <<'PY'
import json
import sys

command = sys.argv[1]
empty_message = sys.argv[2]
text = sys.argv[3]
lines = [line.rstrip() for line in text.splitlines() if line.strip()]
payload = {
    "success": True,
    "tool": "usb",
    "command": command,
    "count": len(lines),
    "items": lines,
}
if not lines:
    payload["message"] = empty_message
print(json.dumps(payload, indent=2))
PY
        return 0
    fi

    if [[ -n "${text//[$' \t\n']/}" ]]; then
        printf '%s\n' "$text"
    else
        echo "$empty_message"
    fi
}

show_help() {
    cat << 'EOF'
agent-usb - USB device management

Commands:
  list                       List USB devices
  tree                       Show USB device tree
  info <device>              Show device info
  eject <device>             Safely eject device
  mount <device>             Mount USB storage
  unmount <device>           Unmount USB storage

Options:
  --json                     Emit structured JSON output

Examples:
  agent-usb list
  agent-usb tree
  agent-usb eject "USB Flash Drive"
  agent-usb mount /dev/disk2s1
EOF
}

cmd_list() {
    local output
    if [[ "$(uname)" == "Darwin" ]]; then
        output="$(system_profiler SPUSBDataType 2>/dev/null | grep -E "^\s+(Product ID|Vendor ID|Manufacturer|Speed|Serial Number|[A-Za-z].*:$)" | head -50 || true)"
    else
        if command -v lsusb &> /dev/null; then
            output="$(lsusb || true)"
        elif [[ -d /sys/bus/usb/devices/ ]]; then
            output="$(ls -la /sys/bus/usb/devices/ 2>/dev/null || true)"
        else
            json_error "lsusb not found and no /sys/bus/usb/devices/ available" 1
            return 1
        fi
    fi
    emit_lines "list" "No USB devices found" "$output"
}

cmd_tree() {
    local output
    if [[ "$(uname)" == "Darwin" ]]; then
        output="$(system_profiler SPUSBDataType 2>/dev/null || true)"
    else
        if command -v lsusb &> /dev/null; then
            output="$(lsusb -t || true)"
        else
            json_error "lsusb not found" 1
            return 1
        fi
    fi
    emit_lines "tree" "No USB devices found" "$output"
}

cmd_info() {
    local device="${1:-}"

    if [[ -z "$device" ]]; then
        json_error "Device name or ID required" 1
        return 1
    fi

    local output
    if [[ "$(uname)" == "Darwin" ]]; then
        output="$(system_profiler SPUSBDataType 2>/dev/null | grep -A 20 -i "$device" || true)"
    else
        if command -v lsusb &> /dev/null; then
            output="$(lsusb -v 2>/dev/null | grep -A 30 -i "$device" || lsusb | grep -i "$device" || true)"
        else
            json_error "lsusb not found" 1
            return 1
        fi
    fi
    emit_lines "info" "No USB device matched: $device" "$output"
}

cmd_eject() {
    local device="$*"

    if [[ -z "$device" ]]; then
        json_error "Device name required" 1
        return 1
    fi

    if [[ "$(uname)" == "Darwin" ]]; then
        # Try by name first using diskutil
        if [[ "$device" =~ ^/dev/ ]]; then
            diskutil eject "$device"
        else
            # Find the device by volume name
            local disk
            disk=$(diskutil list | grep -i "$device" | awk '{print $NF}' | head -1)
            if [[ -n "$disk" ]]; then
                diskutil eject "$disk"
            else
                # Try osascript
                osascript -e "tell application \"Finder\" to eject \"$device\"" 2>/dev/null || \
                    echo "Error: Could not find device: $device"
            fi
        fi
    else
        if [[ "$device" =~ ^/dev/ ]]; then
            udisksctl unmount -b "$device" 2>/dev/null && \
            udisksctl power-off -b "$device" 2>/dev/null || \
            umount "$device"
        else
            echo "Error: Provide device path (e.g., /dev/sdb1)"
            return 1
        fi
    fi

    echo "Ejected: $device"
}

cmd_mount() {
    local device="${1:-}"
    local mount_point="${2:-}"

    if [[ -z "$device" ]]; then
        echo "Error: Device required"
        return 1
    fi

    if [[ "$(uname)" == "Darwin" ]]; then
        diskutil mount "$device"
    else
        if [[ -z "$mount_point" ]]; then
            # Use udisks if available
            if command -v udisksctl &> /dev/null; then
                udisksctl mount -b "$device"
            else
                echo "Error: Mount point required"
                return 1
            fi
        else
            mkdir -p "$mount_point"
            mount "$device" "$mount_point"
        fi
    fi
}

cmd_unmount() {
    local device="${1:-}"

    if [[ -z "$device" ]]; then
        echo "Error: Device required"
        return 1
    fi

    if [[ "$(uname)" == "Darwin" ]]; then
        diskutil unmount "$device"
    else
        if command -v udisksctl &> /dev/null; then
            udisksctl unmount -b "$device"
        else
            umount "$device"
        fi
    fi

    echo "Unmounted: $device"
}

cmd_disks() {
    local output
    if [[ "$(uname)" == "Darwin" ]]; then
        output="$(diskutil list || true)"
    else
        output="$(lsblk -o NAME,SIZE,TYPE,MOUNTPOINT,LABEL 2>/dev/null || fdisk -l 2>/dev/null || true)"
    fi
    emit_lines "disks" "No disks found" "$output"
}

parse_output_format "$@"
ARGS=("${PARSED_ARGS[@]:-}")

# Main
case "${ARGS[0]:-help}" in
    list|ls|devices)
        cmd_list
        ;;
    tree)
        cmd_tree
        ;;
    info|show)
        cmd_info "${ARGS[@]:1}"
        ;;
    eject|safely-remove)
        cmd_eject "${ARGS[@]:1}"
        ;;
    mount)
        cmd_mount "${ARGS[@]:1}"
        ;;
    unmount|umount)
        cmd_unmount "${ARGS[@]:1}"
        ;;
    disks|volumes)
        cmd_disks
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        json_error "Unknown command: ${ARGS[0]}" 1
        if [[ "${OUTPUT_FORMAT:-text}" != "json" ]]; then
            echo "Try: agent-usb help" >&2
        fi
        exit 1
        ;;
esac
