#!/usr/bin/env bash
# agent-dpt - Design Perception Tensor: AI-first design quality scoring
# Part of the agent-do ecosystem
#
# "DPT does not measure taste. It measures whether the unconscious will flinch."
#
# 65 rules across 5 perception layers (chromatic field, typographic skeleton,
# spatial rhythm, attention architecture, coherence) fused into a 0-100 score.

set -euo pipefail

# Resolve DPT_DIR from this script's location.
# Works whether invoked directly from dpt/bin/ or via symlink from agent-do/tools/.
SCRIPT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
# Follow symlinks to find the real script location
while [[ -L "$SCRIPT_PATH" ]]; do
    LINK_TARGET="$(readlink "$SCRIPT_PATH")"
    if [[ "$LINK_TARGET" == /* ]]; then
        SCRIPT_PATH="$LINK_TARGET"
    else
        SCRIPT_PATH="$(dirname "$SCRIPT_PATH")/$LINK_TARGET"
    fi
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

# DPT_DIR is the parent of bin/
DPT_DIR="$(dirname "$SCRIPT_DIR")"
DPT_ENGINE="$DPT_DIR/dist/dpt-engine.js"
DPT_REPORT="$DPT_DIR/bin/dpt-report"
TMPDIR_ACTUAL="$(python3 -c 'import tempfile; print(tempfile.gettempdir())')"
BROWSE_SESSION="${AGENT_BROWSER_SESSION:-$(python3 <<'PY'
import os
import re

def sanitize(value: str) -> str:
    value = re.sub(r'[^a-zA-Z0-9._-]+', '-', value).strip('-_.').lower()
    return value[:24]

def compact(value: str) -> str:
    value = re.sub(r'[^a-zA-Z0-9]+', '', value).lower()
    return value[:16]

candidates = [
    ("codex", os.environ.get("CODEX_THREAD_ID")),
    ("claude", os.environ.get("CLAUDE_THREAD_ID")),
    ("claude", os.environ.get("CLAUDE_SESSION_ID")),
    ("claude", os.environ.get("CLAUDE_AGENT_ID")),
]

for prefix, value in candidates:
    if not value:
        continue
    short = compact(value)
    if short:
        print(f"{prefix}-{short}")
        raise SystemExit(0)

tmux_pane = os.environ.get("TMUX_PANE")
if tmux_pane:
    short = sanitize(tmux_pane).lstrip("%")
    if short:
        print(f"tmux-{short}")
        raise SystemExit(0)

print("default")
PY
)}"
BROWSE_SOCKET_PATH="${TMPDIR_ACTUAL}/agent-browser-${BROWSE_SESSION}.sock"
DPT_STATE_DIR="${AGENT_DO_HOME:-$HOME/.agent-do}/dpt"
BASELINE_DIR="$DPT_STATE_DIR/baselines"
DPT_RESULT_FILE=$(mktemp "${TMPDIR_ACTUAL}/dpt-result-XXXXXX")

cleanup() { rm -f "$DPT_RESULT_FILE"; }
trap cleanup EXIT

show_help() {
    cat << 'EOF'
agent-dpt - Design Perception Tensor

Automated design quality scoring: 65 rules, 5 perception layers, 0-100 score.

COMMANDS:
  scan [url]           Full scan → structured JSON
  score [url]          Quick: score + grade + dimensions + critical failures
  report [url]         Narrative design critique report
  violations [url]     Violations sorted by impact (for AI fix loops)
  baseline [url]       Save a browser-session + project comparison baseline
  diff [url]           Compare current scan against that scoped baseline
  build                Rebuild engine from source
  help                 Show this help

OPTIONS:
  --current            Scan currently open page (default if no URL given)
  --quiet              Machine-readable one-line output (for hooks)
  --json               Raw JSON output (for scan command)
  --viewport WxH       Set viewport before scanning (e.g. --viewport 1920x1080)

REQUIRES:
  agent-do browse      Browser daemon must be running (agent-do browse open <url>)
  python3              For JSON processing and report generation

EXAMPLES:
  agent-dpt score                          # Score current page
  agent-dpt score https://stripe.com       # Score a URL
  agent-dpt violations                     # Get fix list for AI
  agent-dpt baseline                       # Save baseline
  agent-dpt diff                           # Check improvement
  agent-dpt scan --json > result.json      # Export full scan

INSTALL:
  Run: tools/agent-dpt/install.sh              # Sets up agent-do tool + Claude Code hook
  Or:  tools/agent-dpt/install.sh --tool-only  # Just the agent-do tool, no hook
EOF
}

# ============================================================================
# CORE
# ============================================================================

project_root_for() {
    local input="${1:-$PWD}"
    local directory="$input"
    [[ -d "$directory" ]] || directory="$(dirname "$directory")"
    git -C "$directory" rev-parse --show-toplevel 2>/dev/null || (
        cd "$directory" 2>/dev/null && pwd -P
    )
}

baseline_file_for_project() {
    local project_root="$1"
    local project_key
    project_key=$(python3 - "$project_root" <<'PY'
import hashlib
import os
import sys
root = os.path.realpath(sys.argv[1])
print(hashlib.sha256(root.encode("utf-8")).hexdigest()[:16])
PY
)
    printf '%s/%s-%s.json\n' "$BASELINE_DIR" "$BROWSE_SESSION" "$project_key"
}

current_url() {
    local sock
    sock=$(find_socket) || return 1
    python3 - "$sock" <<'PY'
import json
import socket
import sys

message = json.dumps({"id": "dpt-current-url", "action": "url"}).encode("utf-8") + b"\n"
client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
client.settimeout(3)
client.connect(sys.argv[1])
client.sendall(message)
raw = b""
while b"\n" not in raw:
    chunk = client.recv(4096)
    if not chunk:
        break
    raw += chunk
client.close()
response = json.loads(raw.decode("utf-8").strip())
data = response.get("data") or {}
url = data.get("url") or (data.get("result") or {}).get("url")
if not response.get("success") or not url:
    raise SystemExit(1)
print(url)
PY
}

guard_page_matches_project() {
    local file_path="$1"
    local project_root baseline_file open_url
    project_root=$(project_root_for "$file_path") || {
        echo "DPT skipped: cannot resolve the edited file's project root."
        return 1
    }
    baseline_file=$(baseline_file_for_project "$project_root")
    if [[ ! -f "$baseline_file" ]]; then
        echo "DPT skipped: this browser session has no baseline for the edited project. Run: agent-do dpt baseline"
        return 1
    fi
    open_url=$(current_url) || {
        echo "DPT skipped: the current browser page could not be read."
        return 1
    }

    if ! python3 - "$baseline_file" "$project_root" "$open_url" <<'PY'
import json
import os
import sys
from pathlib import Path
from urllib.parse import unquote, urlparse

baseline_path, expected_root, current_url = sys.argv[1:]
with open(baseline_path) as handle:
    baseline = json.load(handle)
context = baseline.get("_dpt_baseline") or {}
baseline_root = os.path.realpath(context.get("project_root") or "")
expected_root = os.path.realpath(expected_root)
baseline_url = context.get("url") or baseline.get("meta", {}).get("url") or ""

if baseline_root != expected_root or not baseline_url:
    raise SystemExit(1)

before = urlparse(baseline_url)
current = urlparse(current_url)
if before.scheme in {"http", "https"} and current.scheme in {"http", "https"}:
    def origin(parsed):
        default = 443 if parsed.scheme == "https" else 80
        return parsed.scheme, (parsed.hostname or "").lower(), parsed.port or default
    matches = origin(before) == origin(current)
elif before.scheme == "file" and current.scheme == "file":
    try:
        current_path = Path(unquote(current.path)).resolve()
        current_path.relative_to(Path(expected_root).resolve())
        matches = True
    except (OSError, ValueError):
        matches = False
else:
    matches = baseline_url == current_url

raise SystemExit(0 if matches else 1)
PY
    then
        echo "DPT skipped: the open page does not match the edited project's baseline."
        return 1
    fi
}

probe_socket() {
    local sock="$1"
    python3 - "$sock" <<'PY' >/dev/null 2>&1
import json
import socket
import sys

sock_path = sys.argv[1]
msg = json.dumps({"id": "dpt-probe", "action": "url"}).encode("utf-8") + b"\n"
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(3)
s.connect(sock_path)
s.sendall(msg)
raw = b""
while True:
    chunk = s.recv(4096)
    if not chunk:
        break
    raw += chunk
    if b"\n" in raw:
        break
s.close()
resp = json.loads(raw.decode("utf-8").strip())
if not resp.get("success"):
    raise SystemExit(1)
PY
}

find_socket() {
    local sock="$BROWSE_SOCKET_PATH"
    [[ -S "$sock" ]] && probe_socket "$sock" && { echo "$sock"; return 0; }
    return 1
}

navigate_if_url() {
    local url="$1"
    if [[ -n "$url" && "$url" != "--"* ]]; then
        agent-do browse open "$url" > /dev/null 2>&1
        agent-do browse wait --stable > /dev/null 2>&1
        sleep 1
    fi
}

set_viewport_if_requested() {
    local vp="$1"
    if [[ -n "$vp" && "$vp" =~ ^([0-9]+)x([0-9]+)$ ]]; then
        agent-do browse viewport "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" > /dev/null 2>&1
        sleep 0.5
    fi
}

inject_engine() {
    local sock
    sock=$(find_socket) || { echo "No responsive agent-browser daemon for session '${BROWSE_SESSION}'. Start: agent-do browse open <url>" >&2; return 1; }
    [[ -f "$DPT_ENGINE" ]] || { echo "Engine not found. Run: agent-dpt build" >&2; return 1; }

    python3 -c "
import json, socket, sys
with open(sys.argv[1]) as f:
    js = f.read()
msg = json.dumps({'id': 'agent-dpt', 'action': 'evaluate', 'script': js})
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(45)
s.connect(sys.argv[2])
s.sendall(msg.encode('utf-8') + b'\n')
chunks = []
while True:
    try:
        chunk = s.recv(131072)
        if not chunk: break
        chunks.append(chunk)
        try:
            json.loads(b''.join(chunks)); break
        except json.JSONDecodeError: continue
    except socket.timeout: break
s.close()
raw = b''.join(chunks).decode('utf-8', errors='replace')
resp = json.loads(raw)
if resp.get('success'):
    result = resp.get('data', {}).get('result', {})
    if isinstance(result, str): result = json.loads(result)
    with open(sys.argv[3], 'w') as out:
        json.dump(result, out)
else:
    sys.exit(1)
" "$DPT_ENGINE" "$sock" "$DPT_RESULT_FILE"
}

# ============================================================================
# COMMANDS
# ============================================================================

cmd_scan() {
    local url="" json_out=false viewport=""
    while [[ $# -gt 0 ]]; do
        case "$1" in --current|-c) shift ;; --json|-j) json_out=true; shift ;; --viewport) viewport="$2"; shift 2 ;; --*) shift ;; *) url="$1"; shift ;; esac
    done
    set_viewport_if_requested "$viewport"
    navigate_if_url "$url"
    inject_engine || exit 1
    if [[ "$json_out" == true ]]; then cat "$DPT_RESULT_FILE"; else python3 -m json.tool "$DPT_RESULT_FILE"; fi
}

cmd_score() {
    local url="" quiet=false viewport="" json_out=false project_file=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --current|-c) shift ;;
            --quiet|-q) quiet=true; shift ;;
            --json|-j) json_out=true; shift ;;
            --viewport) viewport="$2"; shift 2 ;;
            --for-file) project_file="$2"; shift 2 ;;
            --*) shift ;;
            *) url="$1"; shift ;;
        esac
    done
    if [[ -n "$project_file" ]]; then
        guard_page_matches_project "$project_file" || return 0
        local hmr_wait="${DPT_HOOK_HMR_WAIT:-2}"
        if [[ "$hmr_wait" =~ ^[0-9]+([.][0-9]+)?$ && "$hmr_wait" != "0" ]]; then
            sleep "$hmr_wait"
        fi
    fi
    set_viewport_if_requested "$viewport"
    navigate_if_url "$url"
    inject_engine || exit 1

    if [[ "$json_out" == true ]]; then
        python3 - "$DPT_RESULT_FILE" << 'SCORE_JSON_PY'
import json, sys
with open(sys.argv[1]) as f:
    data = json.load(f)
syn = data.get("synthesis", {})
meta = data.get("meta", {})
out = {
    "overall_score": syn.get("overall_score"),
    "overall_grade": syn.get("overall_grade"),
    "dimensions": syn.get("dimensions", {}),
    "critical_failures": syn.get("critical_failures", []),
    "top_strengths": syn.get("top_strengths", []),
    "meta": meta,
}
print(json.dumps(out))
SCORE_JSON_PY
        return
    fi

    local qflag="false"; [[ "$quiet" == true ]] && qflag="true"
    python3 - "$DPT_RESULT_FILE" "$qflag" << 'SCORE_PY'
import json, sys
with open(sys.argv[1]) as f:
    data = json.load(f)
syn = data.get("synthesis", {})
dims = syn.get("dimensions", {})
meta = data.get("meta", {})
score = syn.get("overall_score", "?")
grade = syn.get("overall_grade", "?")
crit = syn.get("critical_failures", [])
strengths = syn.get("top_strengths", [])
quiet = sys.argv[2] == "true"
if score is None:
    score = "INCOMPLETE"

if quiet:
    dp = []
    for k in ["chromatic", "typography", "spatial", "attention", "coherence"]:
        value = dims.get(k, {}).get("score", "?")
        dp.append(f"{k[:3]}{value if value is not None else 'INCOMPLETE'}")
    cs = f". Critical: {'; '.join(crit)}" if crit else ""
    print(f"DPT: {score} {grade} ({' '.join(dp)}){cs}")
else:
    print(f"\n  DPT: {score} {grade}  ({meta.get('element_count','?')} elements, {meta.get('total_timing_ms','?')}ms)")
    print(f"  URL: {meta.get('url', '?')}\n")
    for k in ["chromatic","typography","spatial","attention","coherence"]:
        d = dims.get(k, {})
        fl = f"  !{','.join(d.get('hard_floors_hit',[]))}" if d.get("hard_floors_hit") else ""
        dimension_score = d.get("score", "?")
        if dimension_score is None:
            dimension_score = "INCOMPLETE"
        print(f"    {k:12s} {dimension_score!s:>10} {d.get('grade','?'):>10}{fl}")
    print()
    if crit: print(f"  Critical: {'; '.join(crit)}")
    if strengths: print(f"  Strengths: {', '.join(strengths)}")
    if crit or strengths: print()
SCORE_PY
}

cmd_report() {
    local url="" viewport="" json_out=false
    while [[ $# -gt 0 ]]; do
        case "$1" in --current|-c) shift ;; --json|-j) json_out=true; shift ;; --viewport) viewport="$2"; shift 2 ;; --*) shift ;; *) url="$1"; shift ;; esac
    done
    set_viewport_if_requested "$viewport"
    navigate_if_url "$url"
    inject_engine || exit 1
    if [[ "$json_out" == true ]]; then
        python3 "$DPT_REPORT" --json "$DPT_RESULT_FILE"
    else
        python3 "$DPT_REPORT" "$DPT_RESULT_FILE"
    fi
}

cmd_violations() {
    local url="" viewport="" json_out=false
    while [[ $# -gt 0 ]]; do
        case "$1" in --current|-c) shift ;; --json|-j) json_out=true; shift ;; --viewport) viewport="$2"; shift 2 ;; --*) shift ;; *) url="$1"; shift ;; esac
    done
    set_viewport_if_requested "$viewport"
    navigate_if_url "$url"
    inject_engine || exit 1

    local jflag="false"; [[ "$json_out" == true ]] && jflag="true"
    python3 - "$DPT_RESULT_FILE" "$jflag" << 'VIOL_PY'
import json
import sys

with open(sys.argv[1]) as f:
    data = json.load(f)
json_out = sys.argv[2] == "true"
syn = data.get("synthesis", {})
crit = syn.get("critical_failures", [])

# Maximum weighted contribution to the overall score, in score points. These
# values mirror synthesis.js. Checks absent from this map do not move the score
# and therefore do not belong in an automated fix loop.
SCORED_IMPACT = {
    "cf01_text_contrast": 6.6,
    "cf02_palette": 2.4,
    "cf03_grey_saturation": 2.2,
    "cf04_interactive_primary": 2.2,
    "cf06_dark_mode": 0.8,
    "cf08_saturation_overuse": 0.8,
    "cf09_body_text_softness": 1.0,
    "cf10_complementary_adjacency": 1.6,
    "cf11_saturated_area": 1.4,
    "cf12_perceived_brightness": 1.0,
    "ts01_body_text_min_size": 1.2,
    "ts02_absolute_floor": 3.6,
    "ts03_line_length": 1.5,
    "ts04_body_line_height": 3.3,
    "ts05_headline_line_height": 0.9,
    "ts06_typeface_family_count": 1.8,
    "ts07_font_weight_count": 3.9,
    "ts08_type_scale": 2.1,
    "ts09_headline_size_jump": 3.0,
    "ts13_heading_semantic_visual": 1.2,
    "ts14_heading_space_asymmetry": 1.5,
    "ts17_faux_bold_italic": 2.1,
    "ts19_justified_hyphenation": 1.5,
    "ts21_typeface_distortion": 1.5,
    "ts22_heading_letter_spacing": 0.9,
    "sr01_spacing_scale": 6.75,
    "sr02_touch_targets": 4.0,
    "sr04_border_radius": 3.0,
    "sr05_shadow_elevation": 1.75,
    "sr06_container_max_width": 1.25,
    "sr07_alignment_vectors": 4.0,
    "sr08_whitespace_density": 1.25,
    "sr09_body_text_margin": 3.0,
    "aa02_button_hierarchy": 5.25,
    "aa03_interactive_affordance": 3.25,
    "aa04_icon_text_labels": 2.75,
    "aa06_form_label_presence": 4.25,
    "aa08_generic_link_text": 1.25,
    "aa09_navigation_item_count": 4.25,
    "aa10_tab_order_visual": 4.25,
    "aa11_form_field_border_contrast": 3.0,
    "aa12_generic_button_text": 1.0,
    "aa16_destructive_action_weight": 50.0,
    "co05_animation_duration_bounds": 2.0,
    "co06_transition_property_specificity": 2.0,
}

violations = []

color_parse = data.get("meta", {}).get("color_parse", {})
if color_parse.get("unparseable_count", 0) > 0:
    violations.append({
        "check": "color_parse_incomplete",
        "layer": "CF",
        "impact": 1000.0,
        "unparseable_count": color_parse["unparseable_count"],
        "samples": color_parse.get("samples", []),
    })

for lk, pfx in [("chromatic_field","CF"),("typographic_skeleton","TS"),("spatial_rhythm","SR"),("attention_architecture","AA"),("coherence","CO")]:
    layer = data.get(lk, {})
    if not isinstance(layer, dict): continue
    for ck, cd in layer.items():
        if not isinstance(cd, dict) or ck.startswith("_"): continue
        if ck not in SCORED_IMPACT: continue
        if ck == "cf01_text_contrast":
            hard = [
                item for item in cd.get("violations", [])
                if isinstance(item, dict) and item.get("severity") == "hard"
            ]
            if not hard:
                continue
            hard_count = cd.get("hard_failures", len(hard))
            impact = SCORED_IMPACT[ck]
            if hard_count > 30:
                impact = 100 + (100 - 45) + hard_count / 100
            violations.append({
                "check": ck,
                "layer": pfx,
                "impact": round(impact, 2),
                "hard_failures": hard_count,
                "violations": hard,
            })
            continue
        if cd.get("pass") is not False: continue
        impact = SCORED_IMPACT[ck]
        if ck == "ts02_absolute_floor" and cd.get("sub_12px_count", 0) > 20:
            impact = 100 + (100 - (35 if cd.get("sub_12px_count", 0) > 100 else 55))
        elif ck == "sr02_touch_targets" and cd.get("total_interactive", 0) > 0 and cd.get("undersized") == cd.get("total_interactive"):
            impact = 80 + (100 - 40 if cd.get("undersized", 0) > 50 else 0)
        v = {"check": ck, "layer": pfx, "impact": round(impact, 2)}
        for key in ["violations","undersized","without_hyphens","faux_bold","faux_italic","distorted_elements","generic_links","generic_labels"]:
            if key in cd: v[key] = cd[key]
        if "total_interactive" in cd: v["total"] = cd["total_interactive"]
        violations.append(v)

violations.sort(key=lambda item: (-item["impact"], item["layer"], item["check"]))

if json_out:
    print(json.dumps({
        "critical_failures": crit,
        "count": len(violations),
        "impact_basis": "maximum weighted score points; active hard floors rank first",
        "violations": violations,
    }))
    sys.exit(0)

print(f"\n  VIOLATIONS ({len(violations)} checks failing)\n")
if crit:
    print("  CRITICAL:")
    for c in crit: print(f"    \u2715 {c}")
    print()
for v in violations:
    print(f"  [{v['layer']}] {v['check'].replace('_',' ').upper()}  impact={v['impact']}")
    viols = v.get("violations", [])
    for vl in (viols[:3] if isinstance(viols, list) else []):
        if isinstance(vl, dict):
            sel = vl.get("selector","?")
            dets = [f"{dk}={vl[dk]}" for dk in ["contrast","width","height","text"] if dk in vl]
            print(f"    \u2192 {sel}" + (f" ({', '.join(dets)})" if dets else ""))
    if "undersized" in v: print(f"    \u2192 {v['undersized']}/{v.get('total','?')} below minimum")
    if "faux_bold" in v: print(f"    \u2192 {v['faux_bold']} faux bold, {v.get('faux_italic',0)} faux italic")
print()
VIOL_PY
}

cmd_baseline() {
    local url="" viewport="" project_root baseline_file
    while [[ $# -gt 0 ]]; do
        case "$1" in --current|-c) shift ;; --viewport) viewport="$2"; shift 2 ;; --*) shift ;; *) url="$1"; shift ;; esac
    done
    set_viewport_if_requested "$viewport"
    navigate_if_url "$url"
    inject_engine || exit 1
    project_root=$(project_root_for "$PWD")
    baseline_file=$(baseline_file_for_project "$project_root")
    mkdir -p "$BASELINE_DIR"
    chmod 700 "$BASELINE_DIR"
    python3 - "$DPT_RESULT_FILE" "$baseline_file" "$project_root" "$BROWSE_SESSION" <<'BASELINE_PY'
import json
import os
import sys
import tempfile

source, destination, project_root, browser_session = sys.argv[1:]
with open(source) as handle:
    data = json.load(handle)
data["_dpt_baseline"] = {
    "browser_session": browser_session,
    "project_root": os.path.realpath(project_root),
    "url": data.get("meta", {}).get("url"),
}
directory = os.path.dirname(destination)
descriptor, temporary = tempfile.mkstemp(prefix=".baseline-", suffix=".json", dir=directory)
try:
    with os.fdopen(descriptor, "w") as handle:
        json.dump(data, handle)
        handle.write("\n")
    os.chmod(temporary, 0o600)
    os.replace(temporary, destination)
except BaseException:
    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass
    raise

synthesis = data.get("synthesis", {})
print(f"Baseline saved: {synthesis.get('overall_score', '?')} {synthesis.get('overall_grade', '?')} -> {destination}")
BASELINE_PY
}

cmd_diff() {
    local url="" viewport="" project_root baseline_file
    while [[ $# -gt 0 ]]; do
        case "$1" in --current|-c) shift ;; --viewport) viewport="$2"; shift 2 ;; --*) shift ;; *) url="$1"; shift ;; esac
    done
    project_root=$(project_root_for "$PWD")
    baseline_file=$(baseline_file_for_project "$project_root")
    [[ -f "$baseline_file" ]] || { echo "No baseline for browser session '$BROWSE_SESSION' and project '$project_root'. Run: agent-dpt baseline" >&2; exit 1; }
    set_viewport_if_requested "$viewport"
    navigate_if_url "$url"
    inject_engine || exit 1

    python3 - "$baseline_file" "$DPT_RESULT_FILE" << 'DIFF_PY'
import json, sys
with open(sys.argv[1]) as f: baseline = json.load(f)
with open(sys.argv[2]) as f: current = json.load(f)
bs, cs = baseline.get("synthesis",{}), current.get("synthesis",{})
bd, cd = bs.get("dimensions",{}), cs.get("dimensions",{})
b_s, c_s = bs.get("overall_score",0), cs.get("overall_score",0)
if b_s is None or c_s is None:
    raise SystemExit("DPT diff unavailable: baseline or current scan is incomplete; resolve unparseable CSS colors first")
d = c_s - b_s
arr = "\u25b2" if d>0 else "\u25bc" if d<0 else "="
col = "\033[32m" if d>0 else "\033[31m" if d<0 else "\033[33m"
rst = "\033[0m"
print(f"\n  DPT DIFF: {b_s} {bs.get('overall_grade','?')} \u2192 {c_s} {cs.get('overall_grade','?')}  {col}{arr}{abs(d):+d}{rst}\n")
grn, red = "\033[32m", "\033[31m"
up, dn = "\u25b2", "\u25bc"
for k in ["chromatic","typography","spatial","attention","coherence"]:
    b = bd.get(k,{}).get("score",0); c = cd.get(k,{}).get("score",0); dd = c-b
    if dd:
        dcol = grn if dd>0 else red
        darr = up if dd>0 else dn
        print(f"    {k:12s} {b:>3} \u2192 {c:>3}  {dcol}{darr}{abs(dd)}{rst}")
    else: print(f"    {k:12s} {b:>3} \u2192 {c:>3}  =")
nc = set(cs.get("critical_failures",[])) - set(bs.get("critical_failures",[]))
rv = set(bs.get("critical_failures",[])) - set(cs.get("critical_failures",[]))
if nc: print(f"\n  \033[31mNew critical:\033[0m {'; '.join(nc)}")
if rv: print(f"  \033[32mResolved:\033[0m {'; '.join(rv)}")
print()
DIFF_PY
}

cmd_build() { bash "$DPT_DIR/bin/build"; }

# ============================================================================
# DISPATCH
# ============================================================================

main() {
    local cmd="${1:-help}"; shift 2>/dev/null || true
    case "$cmd" in
        scan|s)             cmd_scan "$@" ;;
        score|sc)           cmd_score "$@" ;;
        report|r)           cmd_report "$@" ;;
        violations|v|fix)   cmd_violations "$@" ;;
        baseline|bl)        cmd_baseline "$@" ;;
        diff|d)             cmd_diff "$@" ;;
        build|b)            cmd_build ;;
        help|--help|-h)     show_help ;;
        *)                  echo "Unknown: $cmd. Try: agent-dpt help" >&2; exit 1 ;;
    esac
}

main "$@"
