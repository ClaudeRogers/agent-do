#!/usr/bin/env bash
# agent-zpc — Structured project memory for AI coding agents
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SCRIPT_DIR/lib"

# Source agent-do shared libraries
source "${SCRIPT_DIR}/../../lib/json-output.sh" 2>/dev/null || true
source "${SCRIPT_DIR}/../../lib/snapshot.sh" 2>/dev/null || true

# Source ZPC libraries
source "$LIB_DIR/common.sh"
source "$LIB_DIR/epistemics.sh" 2>/dev/null || true
source "$LIB_DIR/memory.sh" 2>/dev/null || true
source "$LIB_DIR/position.sh" 2>/dev/null || true
source "$LIB_DIR/counsel.sh" 2>/dev/null || true
source "$LIB_DIR/relitigate.sh" 2>/dev/null || true
source "$LIB_DIR/intelligence.sh" 2>/dev/null || true
source "$LIB_DIR/integration.sh" 2>/dev/null || true

# Parse --json flag
parse_output_format "$@" 2>/dev/null || true
set -- "${PARSED_ARGS[@]+"${PARSED_ARGS[@]}"}"

show_help() {
    cat << 'EOF'
agent-zpc - Structured project memory for AI coding agents

Commands:
  learn <ctx> <prob> <sol> <takeaway> --tags "t1,t2"   Capture a lesson
  decide <problem> --options "a,b" --chosen a ...       Log a decision
  decide-batch [--file F] [--tags "t1,t2"]             Batch-log decisions (stdin)
  retract <id> --evidence "<receipt>"                   Correct a wrong claim (append-only)
  retract --candidate <id> --evidence "<what you saw>"  File cheap doubt: a challenge
  position add|flip|list|show                           Verdict + falsifier ledger
  counsel --brief <file> | --auto-brief                 Clean-context second opinion
  harvest [--auto] [--dry-run]                          Consolidation scan
  harvest --corrections [--since DATE] [--dry-run]      Mine past corrections into preference lessons
  query [--global] [--tag X] [--since DATE] [--text "..."] Search project and optional global memory
  patterns [--score]                                    View/score patterns
  review [--since DATE] [--auto] [--dry-run]             Post-sprint lesson extraction
  promote <source> --to team|global                     Promote lessons
  inject [--compact] [--preferences] [--relitigate]     Emit agent context blob
  init [--platform claude|cursor|codex|generic]         Initialize .zpc/
  status                                                Memory snapshot
  checkpoint [--phase "name"] [--agents "a1,a2"]        Swarm phase boundary
  profile [show|update|detect]                          Manage project profile

Global flags:
  --json        Output as JSON
  --help, -h    Show this help

Examples:
  agent-zpc init
  agent-zpc learn "testing" "assertion failed" "added null check" "validate inputs" --tags "testing,validation"
  agent-zpc decide "Which ORM?" --options "prisma,drizzle,raw" --chosen prisma --rationale "team knows it"
  echo "Color | oklch dark | perceptual" | agent-zpc decide-batch --tags "design"
  agent-zpc status
  agent-zpc checkpoint --phase "Phase 1" --agents "agent-a,agent-b"
  agent-zpc review --since HEAD~20 --dry-run
  agent-zpc harvest
  agent-zpc harvest --corrections --dry-run             # what past sessions already told you
  agent-zpc query --tag testing --since 2025-01-01
  agent-zpc inject
  agent-zpc inject --compact                            # bounded blob for a subagent's prompt
  agent-zpc inject --preferences                        # machine-wide preferences; no .zpc store needed
  agent-zpc inject --relitigate                         # also re-try the most-injected claims now (detached)
  agent-zpc retract les-1a2b3c --evidence "src/api.ts:44 sets Retry-After on every 429"
  agent-zpc retract --candidate les-1a2b3c --evidence "no such handler in src/ as of today"
  agent-zpc position add "the proxy corrupts the payload" --verdict "double content-encoding" --confidence med --falsifier "byte-identical body across the hop"
  agent-zpc counsel --brief .dev/receipts.md --question "Did the payload survive the hop?"
  agent-zpc counsel --auto-brief                        # receipts assembled by machine, not chosen
EOF
}

CMD="${1:-help}"
shift 2>/dev/null || true

case "$CMD" in
    learn)
        cmd_learn "$@"
        ;;
    decide|decision)
        cmd_decide "$@"
        ;;
    decide-batch|batch-decide|batch)
        cmd_decide_batch "$@"
        ;;
    retract)
        cmd_retract "$@"
        ;;
    position)
        cmd_position "$@"
        ;;
    counsel)
        cmd_counsel "$@"
        ;;
    checkpoint|cp)
        cmd_checkpoint "$@"
        ;;
    harvest|consolidate)
        cmd_harvest "$@"
        ;;
    query|search|find)
        cmd_query "$@"
        ;;
    patterns)
        cmd_patterns "$@"
        ;;
    review)
        cmd_review "$@"
        ;;
    promote)
        cmd_promote "$@"
        ;;
    inject|context)
        cmd_inject "$@"
        ;;
    init|setup)
        cmd_init "$@"
        ;;
    status|snapshot)
        cmd_status "$@"
        ;;
    profile)
        cmd_profile "$@"
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo "Unknown command: $CMD" >&2
        echo "Run 'agent-zpc help' for usage." >&2
        exit 1
        ;;
esac
