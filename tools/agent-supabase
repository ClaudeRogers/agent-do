# ============================================================================
# Edge function deploy
# ============================================================================

cmd_function_deploy() {
    local ref="" slug="" name="" file="" verify_jwt="true"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name) name="$2"; shift 2 ;;
            --file) file="$2"; shift 2 ;;
            --no-verify-jwt) verify_jwt="false"; shift ;;
            -*) echo "Unknown flag: $1" >&2; return 1 ;;
            *) if [[ -z "$ref" ]]; then ref="$1"; elif [[ -z "$slug" ]]; then slug="$1"; else echo "Unexpected argument: $1" >&2; return 1; fi; shift ;;
        esac
    done
    if [[ -z "$ref" || -z "$slug" || -z "$file" ]]; then
        echo "Usage: agent-supabase function-deploy <ref> <slug> --file <path> [--name <n>] [--no-verify-jwt]" >&2
        return 1
    fi
    if [[ ! -f "$file" ]]; then
        echo "Error: file not found: $file" >&2
        return 1
    fi
    [[ -z "$name" ]] && name="$slug"
    local body
    body=$(python3 -c "
import json, sys
slug, name, path, verify = sys.argv[1:5]
with open(path) as f:
    src = f.read()
print(json.dumps({'slug': slug, 'name': name, 'body': src, 'verify_jwt': verify == 'true'}))
" "$slug" "$name" "$file" "$verify_jwt")
    supabase_request POST "/projects/$ref/functions" "$body" | print_json
}

cmd_function_update() {
    local ref="" slug="" name="" file="" verify_jwt=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name) name="$2"; shift 2 ;;
            --file) file="$2"; shift 2 ;;
            --verify-jwt) verify_jwt="true"; shift ;;
            --no-verify-jwt) verify_jwt="false"; shift ;;
            *) if [[ -z "$ref" ]]; then ref="$1"; elif [[ -z "$slug" ]]; then slug="$1"; else echo "Unexpected argument: $1" >&2; return 1; fi; shift ;;
        esac
    done
    if [[ -z "$ref" || -z "$slug" ]]; then
        echo "Usage: agent-supabase function-update <ref> <slug> [--name <n>] [--file <path>] [--verify-jwt|--no-verify-jwt]" >&2
        return 1
    fi
    local src=""
    if [[ -n "$file" ]]; then
        [[ ! -f "$file" ]] && { echo "Error: file not found: $file" >&2; return 1; }
        src=$(cat "$file")
    fi
    local body
    body=$(SRC="$src" python3 -c "
import json, os, sys
name, has_file, verify = sys.argv[1:4]
b = {}
if name: b['name'] = name
if has_file == '1': b['body'] = os.environ['SRC']
if verify: b['verify_jwt'] = (verify == 'true')
print(json.dumps(b))
" "$name" "$([[ -n "$file" ]] && echo 1 || echo 0)" "$verify_jwt")
    supabase_request PATCH "/projects/$ref/functions/$slug" "$body" | print_json
}

cmd_function_delete() {
    local ref="" slug="" yes=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --yes|-y) yes=1; shift ;;
            *) if [[ -z "$ref" ]]; then ref="$1"; elif [[ -z "$slug" ]]; then slug="$1"; else echo "Unexpected argument: $1" >&2; return 1; fi; shift ;;
        esac
    done
    if [[ -z "$ref" || -z "$slug" ]]; then
        echo "Usage: agent-supabase function-delete <ref> <slug> --yes" >&2
        return 1
    fi
    require_yes "delete edge function '$slug' on '$ref'" "$yes" || return 1
    supabase_request DELETE "/projects/$ref/functions/$slug" | print_ack "Deleted function $slug on $ref"
}

