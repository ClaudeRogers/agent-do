cmd_create() {
    local name="" org="" region="" db_pass="" plan="" size="" template="" yes=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --org|--organization|--organization-slug) org="$2"; shift 2 ;;
            --region) region="$2"; shift 2 ;;
            --db-pass|--password) db_pass="$2"; shift 2 ;;
            --plan) plan="$2"; shift 2 ;;
            --size|--instance-size) size="$2"; shift 2 ;;
            --template|--template-url) template="$2"; shift 2 ;;
            --yes|-y) yes=1; shift ;;
            -*) echo "Unknown flag: $1" >&2; return 1 ;;
            *) if [[ -z "$name" ]]; then name="$1"; else echo "Unexpected argument: $1" >&2; return 1; fi; shift ;;
        esac
    done
    if [[ -z "$name" || -z "$org" ]]; then
        echo "Usage: agent-supabase create <name> --org <organization_slug> [--region <r>] [--db-pass <p>] [--plan free|pro] [--size <sz>] [--template <url>] --yes" >&2
        echo "  Get the organization slug from: agent-supabase orgs" >&2
        return 1
    fi
    require_yes "create project '$name' in org '$org' (provisions a billable project)" "$yes" || return 1
    if [[ -z "$db_pass" ]]; then
        db_pass=$(python3 -c "import secrets; print(secrets.token_urlsafe(24))")
        echo "Generated database password: $db_pass" >&2
        echo "Store it now — it is not recoverable from the API." >&2
    fi
    local body
    body=$(python3 -c "
import json, sys
name, org, region, db_pass, plan, size, template = sys.argv[1:8]
b = {'name': name, 'organization_slug': org, 'db_pass': db_pass}
if region: b['region'] = region
if plan: b['plan'] = plan
if size: b['desired_instance_size'] = size
if template: b['template_url'] = template
print(json.dumps(b))
" "$name" "$org" "$region" "$db_pass" "$plan" "$size" "$template")
    supabase_request POST "/projects" "$body" | print_json
}

cmd_update() {
    local ref="" name=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
