    local name="${2:-}"

    if [[ -z "$ref" ]] || [[ -z "$name" ]]; then
        echo "Usage: agent-supabase secret-del <ref> <SECRET_NAME>"
        return 1
    fi

    local body="[\"$name\"]"

    supabase_request DELETE "/projects/$ref/secrets" "$body" > /dev/null
    echo "Deleted secret $name from $ref"
