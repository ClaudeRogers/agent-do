# --- Resolve agent-db ---

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

find_agent_db() {
    # 1. Sibling tool in the same tools/ directory
    if [[ -x "$SCRIPT_DIR/agent-db/agent-db" ]]; then
        echo "$SCRIPT_DIR/agent-db/agent-db"
        return
    fi
    # 2. In PATH via agent-do dispatcher
    if command -v agent-do &>/dev/null; then
        echo "agent-do db"
        return
    fi
    echo ""
}

AGENT_DB_CMD="$(find_agent_db)"

run_agent_db() {
    if [[ -z "$AGENT_DB_CMD" ]]; then
        echo "Error: agent-db not found. Install agent-do or check tools/agent-db/" >&2
        return 1
    fi
    $AGENT_DB_CMD "$@"
}

# Profile name convention: supabase-<ref>
db_profile_name() {
    echo "supabase-${1}"
}

# Get service_role key for a project (cached per invocation)
_SERVICE_ROLE_CACHE=""
_SERVICE_ROLE_REF=""
get_service_role_key() {
    local ref="$1"
    if [[ "$_SERVICE_ROLE_REF" == "$ref" && -n "$_SERVICE_ROLE_CACHE" ]]; then
        echo "$_SERVICE_ROLE_CACHE"
        return
    fi
    local result
    result=$(supabase_request GET "/projects/$ref/api-keys" 2>/dev/null)
    local key
    key=$(echo "$result" | python3 -c "
import json, sys
data = json.load(sys.stdin)
for k in data:
    if k.get('name') == 'service_role':
        print(k.get('api_key', ''))
        break
" 2>/dev/null)
    _SERVICE_ROLE_CACHE="$key"
    _SERVICE_ROLE_REF="$ref"
    echo "$key"
}

# --- Helpers ---

supabase_request() {
    local method="$1"
    local endpoint="$2"
    local data="${3:-}"
    local token="${SUPABASE_ACCESS_TOKEN:-}"

    if [[ -z "$token" ]]; then
        echo "Error: SUPABASE_ACCESS_TOKEN not set" >&2
        return 1
    fi

    local args=(-s -X "$method" "${SUPABASE_API}${endpoint}" \
        -H "Authorization: Bearer $token" \
        -H "Content-Type: application/json")

    if [[ -n "$data" ]]; then
        args+=(-d "$data")
    fi

    curl "${args[@]}"
}

json_escape() {
    python3 -c "import json,sys; print(json.dumps(sys.argv[1]))" "$1"
}

# Guard for destructive or billable operations. Agent-safe: never blocks on
# interactive stdin — the caller must pass --yes (confirmed=1) to proceed.
require_yes() {
    local action="$1"
    local confirmed="$2"
    if [[ "$confirmed" != "1" ]]; then
        echo "Refusing to $action without confirmation." >&2
        echo "Re-run with --yes to proceed." >&2
        return 1
    fi
    return 0
}

# Pretty-print a Supabase API JSON response. Surfaces {message}/{error} as a
# stderr error with non-zero exit; otherwise prints indented JSON.
print_json() {
    python3 -c "
import sys, json
raw = sys.stdin.read().strip()
if not raw or raw == '{}':
    print('(empty response)'); sys.exit(0)
try:
    d = json.loads(raw)
except Exception:
    print(raw); sys.exit(0)
if isinstance(d, dict) and (d.get('message') or d.get('error')):
    sys.stderr.write('Error: ' + str(d.get('message') or d.get('error')) + '\n'); sys.exit(1)
print(json.dumps(d, indent=2))
"
}

# Print an acknowledgement for write ops. Surfaces API errors; otherwise prints
# the success message (argv-passed, injection-safe).
print_ack() {
    local success_msg="$1"
    python3 -c "
import sys, json
success_msg = sys.argv[1]
raw = sys.stdin.read().strip()
if not raw or raw == '{}':
    print(success_msg); sys.exit(0)
try:
    d = json.loads(raw)
except Exception:
    print(success_msg); sys.exit(0)
if isinstance(d, dict) and (d.get('message') or d.get('error')):
    sys.stderr.write('Error: ' + str(d.get('message') or d.get('error')) + '\n'); sys.exit(1)
print(success_msg)
" "$success_msg"
}

