#!/usr/bin/env bash
# agent-hardware - Unified hardware device control

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if [[ -f "$REPO_ROOT/lib/json-output.sh" ]]; then
    # shellcheck source=lib/json-output.sh
    source "$REPO_ROOT/lib/json-output.sh"
fi

show_help() {
    cat << 'EOF'
agent-hardware - Unified hardware device control

Commands:
  snapshot                         Snapshot serial, bluetooth, usb, printers, and MIDI
  serial <command> [args...]       Serial port operations
  bluetooth <command> [args...]    Bluetooth operations
  usb <command> [args...]          USB device operations
  printer <command> [args...]      Printer operations
  midi <command> [args...]         MIDI device operations

Options:
  --json                           Wrap delegated command output in structured JSON

Examples:
  agent-hardware snapshot
  agent-hardware serial list
  agent-hardware serial monitor /dev/tty.usbserial-1234 --baud 115200
  agent-hardware bluetooth devices
  agent-hardware usb list
  agent-hardware printer list
  agent-hardware midi snapshot
EOF
}

resolve_leaf_exec() {
    local leaf="$1"
    local leaf_dir="${AGENT_DO_HARDWARE_TOOL_DIR:-$SCRIPT_DIR}"
    local local_exec="$leaf_dir/agent-$leaf"

    if [[ -x "$local_exec" ]]; then
        echo "$local_exec"
        return 0
    fi

    if command -v "agent-$leaf" >/dev/null 2>&1; then
        command -v "agent-$leaf"
        return 0
    fi

    return 1
}

delegate_domain() {
    local domain="$1"
    shift || true

    local leaf_exec
    if ! leaf_exec="$(resolve_leaf_exec "$domain")"; then
        json_error "agent-$domain is not available" 1
        return 1
    fi

    local stdout_file stderr_file timeout_file status
    stdout_file="$(mktemp)"
    stderr_file="$(mktemp)"
    timeout_file="$(mktemp)"

    # Bound the delegated leaf command. A delegated read verb (usb disks ->
    # diskutil, printer status -> lpstat) can stall on an unresponsive disk or
    # peripheral, and macOS ships no timeout(1); run the leaf through a python
    # subprocess timeout so a hung device yields a structured error instead of
    # hanging past an audit/probe bound. A marker file (not a magic exit code a
    # leaf could itself emit) records that our bound — not the leaf — fired.
    local timeout_secs="${AGENT_DO_HARDWARE_TIMEOUT:-10}"
    set +e
    python3 - "$timeout_secs" "$stdout_file" "$stderr_file" "$timeout_file" "$leaf_exec" "$@" <<'PY'
import subprocess
import sys

timeout = float(sys.argv[1])
stdout_path, stderr_path, timeout_path = sys.argv[2], sys.argv[3], sys.argv[4]
cmd = sys.argv[5:]

try:
    completed = subprocess.run(cmd, capture_output=True, timeout=timeout)
    with open(stdout_path, "wb") as fh:
        fh.write(completed.stdout or b"")
    with open(stderr_path, "wb") as fh:
        fh.write(completed.stderr or b"")
    sys.exit(completed.returncode)
except subprocess.TimeoutExpired:
    with open(timeout_path, "w", encoding="utf-8") as fh:
        fh.write("1")
    sys.exit(1)
except FileNotFoundError:
    sys.exit(127)
PY
    status=$?
    set -e

    # A stalled delegation is bounded above: emit a structured timeout error in
    # whichever format was requested, then exit nonzero (never 124, so probers
    # read an explained refusal rather than a raw hang; never a silent stall).
    if [[ -s "$timeout_file" ]]; then
        rm -f "$stdout_file" "$stderr_file" "$timeout_file"
        if [[ "${OUTPUT_FORMAT:-text}" == "json" ]]; then
            python3 - "$domain" "$timeout_secs" "$@" <<'PY'
import json
import sys

domain = sys.argv[1]
timeout_secs = sys.argv[2]
command = sys.argv[3:]
payload = {
    "success": False,
    "tool": "hardware",
    "domain": domain,
    "command": command,
    "timed_out": True,
    "timeout_seconds": float(timeout_secs),
    "exit_code": 1,
    "error": f"agent-{domain} {' '.join(command)} timed out after {timeout_secs}s".strip(),
}
print(json.dumps(payload, indent=2))
PY
        else
            echo "Error: agent-$domain $* timed out after ${timeout_secs}s" >&2
        fi
        return 1
    fi
    rm -f "$timeout_file"

    if [[ "${OUTPUT_FORMAT:-text}" != "json" ]]; then
        local leaf_stdout leaf_stderr
        leaf_stdout="$(cat "$stdout_file")"
        leaf_stderr="$(cat "$stderr_file")"
        rm -f "$stdout_file" "$stderr_file"

        # Pass the leaf's stdout/stderr through verbatim when it produced output,
        # so existing delegated behavior is preserved.
        if [[ -n "${leaf_stdout//[$' \t\n']/}" ]]; then
            printf '%s\n' "$leaf_stdout"
        fi
        if [[ -n "${leaf_stderr//[$' \t\n']/}" ]]; then
            printf '%s\n' "$leaf_stderr" >&2
        fi

        # Render delegation failures and silent empty results explicitly, so the
        # wrapper never inherits an unexplained exit-1 or a silent exit-0.
        if [[ "$status" -ne 0 ]]; then
            if [[ -z "${leaf_stdout//[$' \t\n']/}" && -z "${leaf_stderr//[$' \t\n']/}" ]]; then
                echo "Error: agent-$domain $* failed (exit $status) with no output" >&2
            fi
        elif [[ -z "${leaf_stdout//[$' \t\n']/}" && -z "${leaf_stderr//[$' \t\n']/}" ]]; then
            echo "agent-$domain $*: no results"
        fi

        return "$status"
    fi

    python3 - "$domain" "$status" "$stdout_file" "$stderr_file" "$@" <<'PY'
import json
import pathlib
import sys

domain = sys.argv[1]
status = int(sys.argv[2])
stdout_path = pathlib.Path(sys.argv[3])
stderr_path = pathlib.Path(sys.argv[4])
command = sys.argv[5:]

stdout = stdout_path.read_text()
stderr = stderr_path.read_text()
stdout_path.unlink(missing_ok=True)
stderr_path.unlink(missing_ok=True)

result = stdout.strip()
try:
    parsed_result = json.loads(result)
except Exception:
    parsed_result = result

payload = {
    "success": status == 0,
    "tool": "hardware",
    "domain": domain,
    "command": command,
    "exit_code": status,
    "result": parsed_result,
}

if stderr.strip():
    payload["stderr"] = stderr.strip()

print(json.dumps(payload, indent=2))
PY

    return "$status"
}

cmd_snapshot() {
    local leaf_dir="${AGENT_DO_HARDWARE_TOOL_DIR:-$SCRIPT_DIR}"
    python3 - "$leaf_dir" <<'PY'
import json
import os
import platform
import subprocess
import sys
from pathlib import Path

leaf_dir = Path(sys.argv[1])


def tool_path(name: str) -> Path:
    return leaf_dir / f"agent-{name}"


def split_lines(text: str) -> list[str]:
    return [line.strip() for line in text.splitlines() if line.strip()]


def run_tool(name: str, *args: str) -> dict:
    path = tool_path(name)
    if not path.exists():
        return {"available": False, "error": f"missing {path.name}"}

    completed = subprocess.run(
        [str(path), *args],
        text=True,
        capture_output=True,
        check=False,
    )
    payload = {
        "available": True,
        "exit_code": completed.returncode,
    }
    if completed.stdout.strip():
        payload["stdout"] = completed.stdout.strip()
    if completed.stderr.strip():
        payload["stderr"] = completed.stderr.strip()
    return payload


serial = run_tool("serial", "list")
serial["ports"] = split_lines(serial.get("stdout", ""))

bluetooth_status = run_tool("bluetooth", "status")
bluetooth_status["status_lines"] = split_lines(bluetooth_status.get("stdout", ""))
bluetooth_devices = run_tool("bluetooth", "devices")
bluetooth_devices["devices"] = split_lines(bluetooth_devices.get("stdout", ""))

usb = run_tool("usb", "list")
usb["devices"] = split_lines(usb.get("stdout", ""))

printer = run_tool("printer", "list")
printer["printers"] = split_lines(printer.get("stdout", ""))

midi = run_tool("midi", "snapshot")
if "stdout" in midi:
    try:
        midi["snapshot"] = json.loads(midi["stdout"])
    except json.JSONDecodeError:
        midi["snapshot"] = {"raw": midi["stdout"]}

snapshot = {
    "tool": "hardware",
    "timestamp": subprocess.run(
        ["date", "-u", "+%Y-%m-%dT%H:%M:%SZ"],
        text=True,
        capture_output=True,
        check=False,
    ).stdout.strip(),
    "platform": platform.system(),
    "serial": serial,
    "bluetooth": {
        "status": bluetooth_status,
        "devices": bluetooth_devices,
    },
    "usb": usb,
    "printer": printer,
    "midi": midi,
}

print(json.dumps(snapshot, indent=2))
PY
}

parse_output_format "${@:-}"
ARGS=("${PARSED_ARGS[@]}")

command="${ARGS[0]:-help}"

case "$command" in
    snapshot|status)
        cmd_snapshot
        ;;
    serial|bluetooth|usb|printer|midi)
        if [[ ${#ARGS[@]} -lt 2 ]]; then
            json_error "Subcommand required for $command" 1
            exit 1
        fi
        delegate_domain "$command" "${ARGS[@]:1}"
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        json_error "Unknown command: $command" 1
        if [[ "${OUTPUT_FORMAT:-text}" != "json" ]]; then
            echo "Try: agent-hardware help" >&2
        fi
        exit 1
        ;;
esac
