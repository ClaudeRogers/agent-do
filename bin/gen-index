#!/usr/bin/env python3
"""Render the lightweight agent-do discovery index from registry truth."""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
import tempfile
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))

from registry import _load_yaml_data  # noqa: E402


def yaml_scalar(value: Any) -> str:
    """JSON strings/scalars are valid YAML and avoid an emitter dependency."""
    return json.dumps(value, ensure_ascii=False)


def routing_key(value: str) -> str:
    key = re.sub(r"[^a-z0-9]+", "_", value.strip().lower()).strip("_")
    return key


def load_inputs(registry_path: Path, overrides_path: Path) -> tuple[dict, dict]:
    registry = _load_yaml_data(registry_path)
    overrides = _load_yaml_data(overrides_path)
    tools = registry.get("tools")
    if not isinstance(tools, dict) or not tools:
        raise ValueError(f"Registry has no tools mapping: {registry_path}")
    if not isinstance(overrides, dict):
        raise ValueError(f"Overrides must be a mapping: {overrides_path}")
    return tools, overrides


def category_assignments(tools: dict, overrides: dict) -> tuple[dict[str, str], list[tuple[str, str]]]:
    raw_categories = overrides.get("categories") or {}
    if not isinstance(raw_categories, dict):
        raise ValueError("overrides categories must be a mapping")

    assignments: dict[str, str] = {}
    categories: list[tuple[str, str]] = []
    unknown: list[str] = []
    for category, config in raw_categories.items():
        if not isinstance(config, dict):
            raise ValueError(f"category {category!r} must be a mapping")
        categories.append((str(category), str(config.get("description") or "")))
        for tool in config.get("tools") or []:
            name = str(tool)
            if name not in tools:
                unknown.append(name)
                continue
            previous = assignments.get(name)
            if previous:
                raise ValueError(f"tool {name!r} appears in categories {previous!r} and {category!r}")
            assignments[name] = str(category)

    if unknown:
        raise ValueError("category overrides reference unknown tools: " + ", ".join(sorted(unknown)))

    if "other" not in raw_categories:
        categories.append(("other", "Additional specialized integrations"))
    for name in tools:
        assignments.setdefault(name, "other")
    return assignments, categories


def render(registry_path: Path, overrides_path: Path) -> str:
    tools, overrides = load_inputs(registry_path, overrides_path)
    assignments, categories = category_assignments(tools, overrides)
    description_overrides = overrides.get("description_overrides") or {}
    routing_overrides = overrides.get("task_routing") or {}
    if not isinstance(description_overrides, dict) or not isinstance(routing_overrides, dict):
        raise ValueError("description_overrides and task_routing must be mappings")

    lines = [
        "# Generated by agent-do/bin/gen-index. Do not edit this installed cache.",
        "# Source of truth: registry.yaml; presentation overrides: docs/index-overrides.yaml",
        "# Regenerate: bin/gen-index --output ~/.factory/agent-do-index.yaml",
        "",
        "version: 1",
        f"tool_count: {len(tools)}",
        f"source: {yaml_scalar('registry.yaml')}",
        f"details: {yaml_scalar('agent-do <tool> --help')}",
        "",
        "categories:",
    ]
    for category, description in categories:
        lines.append(f"  {category}: {yaml_scalar(description)}")

    lines.extend(["", "tools:"])
    category_order = [name for name, _ in categories]
    for category in category_order:
        names = sorted(name for name in tools if assignments[name] == category)
        if not names:
            continue
        lines.append(f"  # {category}")
        for name in names:
            description = description_overrides.get(name, tools[name].get("description") or "")
            lines.append(f"  {name}: {yaml_scalar(str(description))}")

    lines.extend(["", "tool_categories:"])
    for name in sorted(tools):
        lines.append(f"  {name}: {yaml_scalar(assignments[name])}")

    routes: dict[str, str] = {}
    for name in sorted(tools):
        routes.setdefault(routing_key(name), name)
        routing = tools[name].get("routing") or {}
        for keyword in routing.get("discover_keywords") or []:
            key = routing_key(str(keyword))
            if key:
                routes.setdefault(key, name)
    for raw_key, raw_tool in routing_overrides.items():
        key = routing_key(str(raw_key))
        tool = str(raw_tool)
        if not key:
            raise ValueError("task_routing keys may not be empty")
        if tool not in tools:
            raise ValueError(f"task_routing references unknown tool: {tool}")
        routes[key] = tool

    lines.extend(["", "task_routing:"])
    for key in sorted(routes):
        lines.append(f"  {key}: {yaml_scalar(routes[key])}")
    lines.append("")
    return "\n".join(lines)


def write_atomic(path: Path, content: str) -> None:
    path = path.expanduser()
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(content)
        os.replace(temp_name, path)
    except BaseException:
        try:
            os.unlink(temp_name)
        except FileNotFoundError:
            pass
        raise


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--registry", type=Path, default=ROOT / "registry.yaml")
    parser.add_argument("--overrides", type=Path, default=ROOT / "docs" / "index-overrides.yaml")
    parser.add_argument("--output", type=Path, help="Write atomically instead of printing to stdout")
    args = parser.parse_args()
    try:
        content = render(args.registry, args.overrides)
        if args.output:
            write_atomic(args.output, content)
        else:
            print(content, end="")
    except (OSError, RuntimeError, ValueError) as exc:
        print(f"gen-index: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
